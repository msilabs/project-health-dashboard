<template>
    <dialog class="drawer" aria-labelledby="pd-title">
        <form class="sheet" novalidate>
            <div class="sheet-head">
                <div class="who top">
                    <span data-avatar></span>
                    <div class="stack stack-sm">
                        <h2 id="pd-title"></h2>
                        <div class="row small muted" data-meta></div>
                    </div>
                </div>
                <button class="btn btn-ghost btn-sm btn-icon" type="button" data-close aria-label="বন্ধ করুন"><Icon name="x" /></button>
            </div>
            <div class="sheet-body" data-body tabindex="-1"></div>
            <div class="sheet-foot" data-foot></div>
            <div data-lists hidden></div>
        </form>
    </dialog>
</template>

<script>
    const P = PHD;
    const ui = P.ui;
    const esc = P.esc;
    const form = $el.querySelector('form');
    const body = $el.querySelector('[data-body]');
    const foot = $el.querySelector('[data-foot]');
    let current = null;
    let editing = false;

    function find(id) {
        return P.store.get().projects.find(function (p) { return p.id === id; }) || null;
    }

    function meta(p, r) {
        const bits = [r ? ui.badge(r.status) : ''];
        if (p.owner) bits.push('<span>' + esc(p.owner) + '</span>');
        if (p.lifecycle === 'archived') bits.push('<span class="tag">' + esc(P.LIFECYCLES[p.lifecycle]) + '</span>');
        p.tags.forEach(function (t) { bits.push('<span class="tag">' + esc(t) + '</span>'); });
        return bits.join('');
    }

    /* ---------- দেখার মোড ---------- */

    function partsHtml(items) {
        if (!items.length) return '<p class="small muted">কিছু লেখা নেই।</p>';
        return '<div class="parts">' + items.map(function (x) { return ui.part(x, ui.fixLink(x)); }).join('') + '</div>';
    }

    function renderView(p) {
        const r = P.analyzeProject(P.store.get(), p);
        $el.querySelector('#pd-title').textContent = p.name;
        $el.querySelector('[data-avatar]').innerHTML = ui.avatar(p.name, 'lg');
        $el.querySelector('[data-meta]').innerHTML = meta(p, r);
        let html = '';
        if (r.issues.length) {
            html += '<div class="section"><span class="section-title">সামঞ্জস্য আর অমিল</span>' + r.issues.map(function (i) {
                return '<div class="notice s-' + i.severity + '">' + esc(i.text) + '</div>';
            }).join('') + '</div>';
        }
        html += '<div class="section"><span class="section-title">টেক</span>' + partsHtml(r.items.filter(function (x) { return x.kind === 'tech'; })) + '</div>';
        p.deployments.forEach(function (d) {
            const items = r.items.filter(function (x) { return x.kind === 'env' && x.deployment === d.name; });
            html += '<div class="section"><span class="section-title">' + esc(d.name) + '</span>' + partsHtml(items) + '</div>';
        });
        if (!p.deployments.length) html += '<div class="section"><span class="section-title">এনভায়রনমেন্ট</span><p class="small muted">কোনো এনভায়রনমেন্ট যোগ করা হয়নি।</p></div>';
        const info = [];
        if (p.repo) info.push('<a href="' + esc(p.repo) + '" target="_blank" rel="noopener">' + esc(p.repo.replace(/^https?:\/\//, '')) + '</a>');
        if (p.note) info.push('<span>' + esc(p.note) + '</span>');
        if (p.updatedAt) info.push('<span class="muted">শেষ হালনাগাদ: ' + P.fmtDate(p.updatedAt) + '</span>');
        if (info.length) html += '<div class="section"><span class="section-title">তথ্য</span><div class="stack stack-sm small">' + info.join('') + '</div></div>';
        body.innerHTML = html;
        foot.innerHTML =
            '<button class="btn btn-ghost btn-sm" type="button" data-plan>' + ui.icon('sparkles') + 'AI দিয়ে আপগ্রেড পরিকল্পনা</button>' +
            '<button class="btn btn-primary" type="button" data-edit>' + ui.icon('edit') + 'এডিট করুন</button>';
    }

    /* ---------- এডিট মোড ---------- */

    function productName(kind, id) {
        const product = P.findProduct(P.store.get(), kind, id);
        return product ? product.name : id;
    }

    function itemRow(kind, ref) {
        ref = ref || { product: '', version: '' };
        return (
            '<div class="edit-row" data-kind="' + kind + '">' +
            '<input type="text" data-k="product" value="' + esc(productName(kind, ref.product)) + '" list="dl-products-' + kind + '" placeholder="' + (kind === 'tech' ? 'যেমন Laravel' : 'যেমন PHP') + '" aria-label="প্রোডাক্ট" autocomplete="off">' +
            '<input type="text" data-k="version" value="' + esc(ref.version) + '" list="dl-' + kind + '-' + esc(ref.product) + '" placeholder="ভার্সন" aria-label="ভার্সন" autocomplete="off">' +
            '<button class="btn btn-ghost btn-sm btn-icon" type="button" data-remove aria-label="সরান">' + ui.icon('x') + '</button>' +
            '<div class="edit-hint" data-hint hidden></div>' +
            '</div>'
        );
    }

    // লেখা প্রোডাক্ট ক্যাটালগে না থাকলে সারির নিচে জানায়, আর endoflife.date থেকে আনার বোতাম দেয়
    function checkRow(row) {
        const text = row.querySelector('[data-k="product"]').value.trim();
        const hint = row.querySelector('[data-hint]');
        const product = text ? ui.findProductByText(P.store.get(), row.dataset.kind, text) : null;
        row.querySelector('[data-k="version"]').setAttribute('list', 'dl-' + row.dataset.kind + '-' + (product ? product.id : ''));
        hint.hidden = !text || !!product;
        if (!hint.hidden) hint.innerHTML = 'ক্যাটালগে নেই, তাই অবস্থা অজানা দেখাবে। <button class="link-btn" type="button" data-fetch>endoflife.date থেকে তারিখ আনুন</button>';
    }

    function fetchProduct(row, btn) {
        const input = row.querySelector('[data-k="product"]');
        const hint = row.querySelector('[data-hint]');
        const kind = row.dataset.kind;
        const slug = P.slug(input.value);
        if (!slug) return;
        btn.disabled = true;
        btn.textContent = 'আনা হচ্ছে…';
        P.fetchEndOfLife(slug).then(function (result) {
            const product = P.productFromEndOfLife(result, kind, { id: slug });
            P.store.update(function (next) {
                if (!P.findProduct(next, kind, product.id)) next.catalog[kind].push(product);
            });
            $el.querySelector('[data-lists]').innerHTML = ui.datalists(P.store.get());
            input.value = product.name;
            checkRow(row);
            ui.toast(product.name + ' ক্যাটালগে যোগ হয়েছে, ' + P.num(product.versions.length) + 'টি ভার্সনের তারিখসহ।');
        }).catch(function (err) {
            hint.textContent = err.message === 'not-found'
                ? 'endoflife.date-এ এই নামে কিছু নেই। সেভ করা যাবে; পরে ক্যাটালগ পেজে তারিখ লিখে দিতে পারবেন।'
                : 'আনা গেল না। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।';
        });
    }

    function envBlock(d) {
        d = d || { name: '', stack: [] };
        return (
            '<div class="env-block" data-dep>' +
            '<div class="env-head"><input type="text" data-k="name" list="dl-deployments" value="' + esc(d.name) + '" placeholder="production" aria-label="এনভায়রনমেন্টের নাম">' +
            '<button class="btn btn-ghost btn-sm btn-danger" type="button" data-remove-dep>সরান</button></div>' +
            '<div class="stack stack-sm" data-stack>' + (d.stack.length ? d.stack : [null]).map(function (r) { return itemRow('env', r); }).join('') + '</div>' +
            '<div><button class="btn btn-ghost btn-sm" type="button" data-add-env>' + ui.icon('plus') + 'সফটওয়্যার</button></div>' +
            '</div>'
        );
    }

    function renderEdit(p) {
        const data = P.store.get();
        $el.querySelector('#pd-title').textContent = current ? 'প্রজেক্ট এডিট' : 'নতুন প্রজেক্ট';
        $el.querySelector('[data-avatar]').innerHTML = '';
        $el.querySelector('[data-meta]').innerHTML = '';
        $el.querySelector('[data-lists]').innerHTML = ui.datalists(data);
        const hasMore = p.owner || p.tags.length || p.repo || p.note || p.lifecycle === 'archived';
        body.innerHTML =
            '<label class="field"><span>নাম *</span><input type="text" name="name" value="' + esc(p.name) + '" maxlength="120"></label>' +
            '<div class="section"><span class="section-title">টেক <span class="hint">কোডে যা ব্যবহার হয়</span></span>' +
            '<div class="stack stack-sm" data-tech>' + (p.tech.length ? p.tech : [null]).map(function (r) { return itemRow('tech', r); }).join('') + '</div>' +
            '<div><button class="btn btn-ghost btn-sm" type="button" data-add-tech>' + ui.icon('plus') + 'টেক</button></div></div>' +
            '<div class="section"><span class="section-title">এনভায়রনমেন্ট <span class="hint">সার্ভারে যা চলে</span></span>' +
            '<div class="stack" data-deps>' + p.deployments.map(envBlock).join('') + '</div>' +
            '<div><button class="btn btn-ghost btn-sm" type="button" data-add-dep>' + ui.icon('plus') + 'এনভায়রনমেন্ট</button></div></div>' +
            '<details class="fold"' + (hasMore ? ' open' : '') + '><summary>আরও তথ্য</summary>' +
            '<div class="form-grid">' +
            '<label class="field"><span>দায়িত্বে</span><input type="text" name="owner" value="' + esc(p.owner) + '" list="dl-owners"></label>' +
            '<label class="field"><span>ট্যাগ</span><input type="text" name="tags" value="' + esc(p.tags.join(', ')) + '" placeholder="client, payment"></label>' +
            '</div>' +
            '<label class="field"><span>রিপো বা লিংক</span><input type="text" name="repo" value="' + esc(p.repo) + '" placeholder="https://github.com/…"></label>' +
            '<label class="field"><span>নোট</span><textarea class="prose" name="note" rows="2">' + esc(p.note) + '</textarea></label>' +
            '<label class="check"><input type="checkbox" name="archived"' + (p.lifecycle === 'archived' ? ' checked' : '') + '>আর্কাইভ করা (ড্যাশবোর্ডের হিসাবে ধরা হবে না)</label>' +
            '</details>' +
            '<p class="notice s-eol" data-error hidden></p>';
        foot.innerHTML =
            (current ? '<button class="btn btn-ghost btn-sm btn-danger" type="button" data-delete>' + ui.icon('trash') + 'মুছুন</button>' : '<span></span>') +
            '<span class="row"><button class="btn" type="button" data-cancel>বাতিল</button><button class="btn btn-primary" type="submit">সেভ করুন</button></span>';
        ui.$$('.edit-row', body).forEach(checkRow);
        form.elements.name.focus();
    }

    function readRows(container) {
        return Array.prototype.map.call(container.querySelectorAll('.edit-row'), function (row) {
            const text = row.querySelector('[data-k="product"]').value.trim();
            const product = ui.findProductByText(P.store.get(), row.dataset.kind, text);
            return { product: product ? product.id : P.slug(text), version: row.querySelector('[data-k="version"]').value.trim() };
        }).filter(function (r) { return r.product; });
    }

    function collect() {
        const el = form.elements;
        return {
            name: el.name.value.trim(),
            repo: el.repo.value.trim(),
            owner: el.owner.value.trim(),
            tags: el.tags.value,
            lifecycle: el.archived.checked ? 'archived' : 'active',
            note: el.note.value.trim(),
            tech: readRows(body.querySelector('[data-tech]')),
            deployments: Array.prototype.map.call(body.querySelectorAll('[data-dep]'), function (b) {
                return {
                    name: b.querySelector('[data-k="name"]').value.trim(),
                    stack: readRows(b.querySelector('[data-stack]'))
                };
            })
        };
    }

    function showError(msg) {
        const e = body.querySelector('[data-error]');
        e.textContent = msg;
        e.hidden = false;
        e.scrollIntoView({ block: 'nearest' });
    }

    function render() {
        if (editing) {
            const blank = { name: '', repo: '', owner: '', tags: [], lifecycle: 'active', note: '', tech: [], deployments: [{ name: P.DEPLOYMENT_NAMES[0], stack: [] }] };
            renderEdit(current ? find(current) || blank : blank);
        } else {
            const p = find(current);
            if (!p) return $el.close();
            renderView(p);
        }
    }

    // id = null হলে নতুন প্রজেক্ট
    ui.openProject = function (id, opts) {
        current = id && find(id) ? id : null;
        editing = !current || !!(opts && opts.edit);
        render();
        if (!$el.open) $el.showModal();
        body.scrollTop = 0;
        if (!editing) body.focus({ preventScroll: true });
    };

    ui.bindDialog($el, function () {
        current = null;
        editing = false;
        const q = new URLSearchParams(location.search);
        if (q.has('open') || q.has('new')) {
            q.delete('open');
            q.delete('new');
            const s = q.toString();
            history.replaceState(null, '', location.pathname + (s ? '?' + s : ''));
        }
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        const input = collect();
        if (!input.name) return showError('প্রজেক্টের নাম লিখুন।');
        const names = input.deployments.map(function (d) { return d.name || 'production'; });
        if (P.unique(names).length !== names.length) return showError('একই নামের দুটো এনভায়রনমেন্ট আছে। নাম আলাদা করুন।');
        const data = P.store.get();
        let id = current;
        if (!id) {
            const base = P.slug(input.name) || P.uid('project');
            id = base;
            let n = 2;
            while (data.projects.some(function (p) { return p.id === id; })) id = base + '-' + n++;
        }
        const project = P.normalizeProject(Object.assign({}, input, { id: id, updatedAt: P.isoDate(P.today()) }));
        const isNew = !current;
        P.store.update(function (next) {
            const i = next.projects.findIndex(function (p) { return p.id === id; });
            if (i === -1) next.projects.push(project);
            else next.projects[i] = project;
        });
        current = id;
        editing = false;
        render();
        ui.toast(isNew ? '"' + project.name + '" যোগ হয়েছে।' : 'সেভ হয়েছে।');
    });

    $el.addEventListener('click', function (e) {
        const t = e.target.closest('button');
        if (!t) return;
        if (t.hasAttribute('data-edit')) {
            editing = true;
            render();
        } else if (t.hasAttribute('data-cancel')) {
            if (!current) return $el.close();
            editing = false;
            render();
        } else if (t.hasAttribute('data-plan')) {
            ui.showPrompt('আপগ্রেড পরিকল্পনা', P.aiPrompts.plan(P.store.get(), '', { project: current }), find(current).name + '-এর কোন অংশ আগে আর কীভাবে আপগ্রেড করতে হবে, AI ধাপে ধাপে লিখে দেবে।');
        } else if (t.hasAttribute('data-delete')) {
            const p = find(current);
            if (!p) return;
            const next = P.clone(P.store.get());
            next.projects = next.projects.filter(function (x) { return x.id !== p.id; });
            P.store.apply(next, 'প্রজেক্ট মুছে ফেলা');
            $el.close();
            ui.undoToast('"' + p.name + '" মুছে ফেলা হয়েছে।');
        } else if (t.hasAttribute('data-remove')) {
            t.closest('.edit-row').remove();
        } else if (t.hasAttribute('data-add-tech')) {
            body.querySelector('[data-tech]').insertAdjacentHTML('beforeend', itemRow('tech'));
        } else if (t.hasAttribute('data-add-env')) {
            t.closest('[data-dep]').querySelector('[data-stack]').insertAdjacentHTML('beforeend', itemRow('env'));
        } else if (t.hasAttribute('data-add-dep')) {
            const taken = Array.prototype.map.call(body.querySelectorAll('[data-dep] [data-k="name"]'), function (i) { return i.value.trim(); });
            const name = P.deploymentNames(P.store.get()).filter(function (n) { return taken.indexOf(n) === -1; })[0] || '';
            body.querySelector('[data-deps]').insertAdjacentHTML('beforeend', envBlock({ name: name, stack: [] }));
        } else if (t.hasAttribute('data-remove-dep')) {
            t.closest('[data-dep]').remove();
        } else if (t.hasAttribute('data-fetch')) {
            fetchProduct(t.closest('.edit-row'), t);
        }
    });

    $el.addEventListener('input', function (e) {
        if (e.target.matches('input[data-k="product"]')) checkRow(e.target.closest('.edit-row'));
    });

    ui.onChange(function (e) {
        if ($el.open && !editing && e.detail && e.detail.source !== 'save') render();
    });
</script>
