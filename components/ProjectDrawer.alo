<template>
    <dialog class="drawer" aria-labelledby="pd-title">
        <form class="sheet" novalidate>
            <div class="sheet-head">
                <div class="who top">
                    <span data-avatar></span>
                    <div class="stack stack-sm">
                        <h2 id="pd-title"></h2>
                        <div class="row small muted" data-meta></div>
                    </div>
                </div>
                <button class="btn btn-ghost btn-sm btn-icon" type="button" data-close aria-label="বন্ধ করুন"><Icon name="x" /></button>
            </div>
            <div class="sheet-body" data-body tabindex="-1"></div>
            <div class="sheet-foot" data-foot></div>
            <div data-lists hidden></div>
        </form>
    </dialog>
</template>

<script>
    const P = PHD;
    const ui = P.ui;
    const esc = P.esc;
    const form = $el.querySelector('form');
    const body = $el.querySelector('[data-body]');
    const foot = $el.querySelector('[data-foot]');
    let current = null;
    let editing = false;

    function find(id) {
        return P.store.get().projects.find(function (p) { return p.id === id; }) || null;
    }

    function meta(p, r) {
        const bits = [r ? ui.badge(r.status) : ''];
        if (p.owner) bits.push('<span>' + esc(p.owner) + '</span>');
        if (p.lifecycle === 'archived') bits.push('<span class="tag">' + esc(P.LIFECYCLES[p.lifecycle]) + '</span>');
        p.tags.forEach(function (t) { bits.push('<span class="tag">' + esc(t) + '</span>'); });
        return bits.join('');
    }

    /* ---------- দেখার মোড ---------- */

    // দেখার কার্ড: ওপরে নাম আর এখনকার অবস্থা, নিচে নতুন থেকে পুরনো ভার্সন (প্রতিটার আজকের অবস্থার রং)
    function viewCard(item, ref) {
        const data = P.store.get();
        const rows = ref.versions.length ? ref.versions.slice().reverse() : [];
        return (
            '<div class="ver-card is-view">' +
            ui.part(Object.assign({}, item, { label: item.productName }), ui.fixLink(item)) +
            (rows.length ? '<div class="ver-list">' + rows.map(function (v, i) {
                const s = P.evaluateRef(data, item.kind, { product: ref.product, version: v.version }, item.deployment);
                return '<div class="ver-row is-view' + (i === 0 ? ' is-current' : '') + '">' +
                    '<span class="ver-box"><span class="dot s-' + s.status + '" data-tip="' + esc(P.STATUS[s.status].label) + '"></span>' + P.fmtDate(v.date) + '</span>' +
                    '<span class="ver-box ver-v"><b>' + esc(v.version) + '</b>' + (i === 0 ? '<span class="ver-now">এখন</span>' : '') + '</span>' +
                    '</div>';
            }).join('') + '</div>' : '') +
            '</div>'
        );
    }

    function cardsHtml(items, refs) {
        if (!items.length) return '<p class="small muted">কিছু লেখা নেই।</p>';
        return '<div class="stack">' + items.map(function (x, i) { return viewCard(x, refs[i]); }).join('') + '</div>';
    }

    function renderView(p) {
        const r = P.analyzeProject(P.store.get(), p);
        $el.querySelector('#pd-title').textContent = p.name;
        $el.querySelector('[data-avatar]').innerHTML = ui.avatar(p.name, 'lg');
        $el.querySelector('[data-meta]').innerHTML = meta(p, r);
        let html = '';
        if (r.issues.length) {
            html += '<div class="section"><span class="section-title">সামঞ্জস্য আর অমিল</span>' + r.issues.map(function (i) {
                return '<div class="notice s-' + i.severity + '">' + esc(i.text) + '</div>';
            }).join('') + '</div>';
        }
        html += '<div class="section"><span class="section-title">টেক</span>' + cardsHtml(r.items.filter(function (x) { return x.kind === 'tech'; }), p.tech) + '</div>';
        p.deployments.forEach(function (d) {
            const items = r.items.filter(function (x) { return x.kind === 'env' && x.deployment === d.name; });
            html += '<div class="section"><span class="section-title">' + esc(d.name) + '</span>' + cardsHtml(items, d.stack) + '</div>';
        });
        if (!p.deployments.length) html += '<div class="section"><span class="section-title">এনভায়রনমেন্ট</span><p class="small muted">কোনো এনভায়রনমেন্ট যোগ করা হয়নি।</p></div>';
        const info = [];
        if (p.repo) info.push('<a href="' + esc(p.repo) + '" target="_blank" rel="noopener">' + esc(p.repo.replace(/^https?:\/\//, '')) + '</a>');
        if (p.note) info.push('<span>' + esc(p.note) + '</span>');
        if (p.updatedAt) info.push('<span class="muted">শেষ হালনাগাদ: ' + P.fmtDate(p.updatedAt) + '</span>');
        if (info.length) html += '<div class="section"><span class="section-title">তথ্য</span><div class="stack stack-sm small">' + info.join('') + '</div></div>';
        body.innerHTML = html;
        const hasSteps = P.upgradeJourney(P.store.get(), p).length > 0;
        foot.innerHTML =
            '<span class="row">' +
            '<button class="btn btn-ghost btn-sm" type="button" data-plan>' + ui.icon('sparkles') + 'AI দিয়ে আপগ্রেড পরিকল্পনা</button>' +
            (hasSteps ? '<button class="btn btn-ghost btn-sm" type="button" data-copy-summary data-tip="শুরু থেকে এখন পর্যন্ত আপগ্রেডের লেখা, ম্যানেজমেন্টকে পাঠানোর জন্য">' + ui.icon('copy') + 'সারাংশ কপি</button>' : '') +
            '</span>' +
            '<button class="btn btn-primary" type="button" data-edit>' + ui.icon('edit') + 'এডিট করুন</button>';
    }

    /* ---------- এডিট মোড: প্রতিটা টেক বা সফটওয়্যারের কার্ড, ভেতরে তারিখসহ ভার্সনের তালিকা ---------- */

    function productName(kind, id) {
        const product = P.findProduct(P.store.get(), kind, id);
        return product ? product.name : id;
    }

    function today() {
        return P.isoDate(P.today());
    }

    // একটা ভার্সন: কোন তারিখ থেকে চলছে, আর ভার্সন
    function verRow(v, kind, product) {
        v = v || { version: '', date: today() };
        return (
            '<div class="ver-row" data-ver>' +
            '<label class="ver-date">' + ui.icon('edit') + '<input type="date" data-k="date" value="' + esc(v.date) + '" aria-label="কোন তারিখ থেকে"></label>' +
            '<span class="ver-v"><input type="text" data-k="version" value="' + esc(v.version) + '" list="dl-' + kind + '-' + esc(product || '') + '" placeholder="ভার্সন" aria-label="ভার্সন" autocomplete="off"><span class="ver-now">এখন</span></span>' +
            '<button class="btn btn-ghost btn-sm btn-icon" type="button" data-remove-ver aria-label="এই ভার্সন সরান">' + ui.icon('x') + '</button>' +
            '</div>'
        );
    }

    // নতুন ভার্সন ওপরে, পুরনো নিচে
    function card(kind, ref) {
        ref = ref || { product: '', versions: [] };
        const rows = ref.versions.length ? ref.versions.slice().reverse() : [null];
        return (
            '<div class="ver-card" data-card data-kind="' + kind + '">' +
            '<div class="ver-card-head">' +
            '<input type="text" data-k="product" value="' + esc(ref.product ? productName(kind, ref.product) : '') + '" list="dl-products-' + kind + '" placeholder="' + (kind === 'tech' ? 'যেমন Laravel' : 'যেমন PHP') + '" aria-label="প্রোডাক্ট" autocomplete="off">' +
            '<button class="btn btn-ghost btn-sm btn-icon" type="button" data-remove-card aria-label="সরান">' + ui.icon('trash') + '</button>' +
            '<div class="edit-hint" data-hint hidden></div>' +
            '</div>' +
            '<div class="ver-list" data-versions>' +
            '<button class="ver-add" type="button" data-add-version>' + ui.icon('plus') + 'নতুন ভার্সন</button>' +
            rows.map(function (v) { return verRow(v, kind, ref.product); }).join('') +
            '</div>' +
            '<p class="ver-error" data-ver-error hidden>একই তারিখে একাধিক ভার্সন দেওয়া যাবে না।</p>' +
            '</div>'
        );
    }

    function envBlock(d) {
        d = d || { name: '', stack: [] };
        return (
            '<div class="env-block" data-dep>' +
            '<div class="env-head"><input type="text" data-k="name" list="dl-deployments" value="' + esc(d.name) + '" placeholder="production" aria-label="এনভায়রনমেন্টের নাম">' +
            '<button class="btn btn-ghost btn-sm btn-danger" type="button" data-remove-dep>সরান</button></div>' +
            '<div class="stack" data-stack>' + (d.stack.length ? d.stack : [null]).map(function (r) { return card('env', r); }).join('') + '</div>' +
            '<div><button class="btn btn-ghost btn-sm" type="button" data-add-card="env">' + ui.icon('plus') + 'সফটওয়্যার</button></div>' +
            '</div>'
        );
    }

    // লেখা প্রোডাক্ট ক্যাটালগে না থাকলে কার্ডে জানায়, আর endoflife.date থেকে আনার বোতাম দেয়
    function checkCard(c) {
        const text = c.querySelector('[data-k="product"]').value.trim();
        const hint = c.querySelector('[data-hint]');
        const product = text ? ui.findProductByText(P.store.get(), c.dataset.kind, text) : null;
        c.querySelectorAll('[data-k="version"]').forEach(function (i) {
            i.setAttribute('list', 'dl-' + c.dataset.kind + '-' + (product ? product.id : ''));
        });
        hint.hidden = !text || !!product;
        if (!hint.hidden) hint.innerHTML = 'ক্যাটালগে নেই, তাই অবস্থা অজানা দেখাবে। <button class="link-btn" type="button" data-fetch>endoflife.date থেকে তারিখ আনুন</button>';
    }

    // তারিখ অনুযায়ী সাজানো (নতুন ওপরে), আর একই তারিখ থাকলে লাল দাগ
    function sortCard(c) {
        const box = c.querySelector('[data-versions]');
        const rows = Array.prototype.slice.call(box.querySelectorAll('[data-ver]'));
        rows.sort(function (a, b) {
            const x = a.querySelector('[data-k="date"]').value || '0000';
            const y = b.querySelector('[data-k="date"]').value || '0000';
            return x < y ? 1 : x > y ? -1 : 0;
        });
        rows.forEach(function (r) { box.appendChild(r); });
        markCurrent(c);
        return markDuplicates(c);
    }

    // সবচেয়ে নতুন তারিখের (সাজানোয় প্রথম) ভরা সারিটাই এখনকার ভার্সন
    function markCurrent(c) {
        let done = false;
        c.querySelectorAll('[data-ver]').forEach(function (r) {
            const on = !done && !!r.querySelector('[data-k="version"]').value.trim() && !!r.querySelector('[data-k="date"]').value;
            r.classList.toggle('is-current', on);
            if (on) done = true;
        });
    }

    function markDuplicates(c) {
        const count = {};
        const rows = c.querySelectorAll('[data-ver]');
        rows.forEach(function (r) {
            const d = r.querySelector('[data-k="date"]').value;
            if (d) count[d] = (count[d] || 0) + 1;
        });
        let dup = false;
        rows.forEach(function (r) {
            const d = r.querySelector('[data-k="date"]').value;
            const bad = !!d && count[d] > 1;
            r.classList.toggle('is-dup', bad);
            if (bad) dup = true;
        });
        c.querySelector('[data-ver-error]').hidden = !dup;
        return dup;
    }

    function fetchProduct(c, btn) {
        const input = c.querySelector('[data-k="product"]');
        const hint = c.querySelector('[data-hint]');
        const kind = c.dataset.kind;
        const slug = P.slug(input.value);
        if (!slug) return;
        btn.disabled = true;
        btn.textContent = 'আনা হচ্ছে…';
        P.fetchEndOfLife(slug).then(function (result) {
            const product = P.productFromEndOfLife(result, kind, { id: slug });
            P.store.update(function (next) {
                if (!P.findProduct(next, kind, product.id)) next.catalog[kind].push(product);
            });
            $el.querySelector('[data-lists]').innerHTML = ui.datalists(P.store.get());
            input.value = product.name;
            checkCard(c);
            ui.toast(product.name + ' ক্যাটালগে যোগ হয়েছে, ' + P.num(product.versions.length) + 'টি ভার্সনের তারিখসহ।');
        }).catch(function (err) {
            hint.textContent = err.message === 'not-found'
                ? 'endoflife.date-এ এই নামে কিছু নেই। সেভ করা যাবে; পরে ক্যাটালগ পেজে তারিখ লিখে দিতে পারবেন।'
                : 'আনা গেল না। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।';
        });
    }

    function renderEdit(p) {
        const data = P.store.get();
        $el.querySelector('#pd-title').textContent = current ? 'প্রজেক্ট এডিট' : 'নতুন প্রজেক্ট';
        $el.querySelector('[data-avatar]').innerHTML = '';
        $el.querySelector('[data-meta]').innerHTML = '';
        $el.querySelector('[data-lists]').innerHTML = ui.datalists(data);
        const hasMore = p.owner || p.tags.length || p.repo || p.note || p.lifecycle === 'archived';
        body.innerHTML =
            '<label class="field"><span>নাম *</span><input type="text" name="name" value="' + esc(p.name) + '" maxlength="120"></label>' +
            '<div class="section"><span class="section-title"><span>টেক <span class="hint">কোডে যা ব্যবহার হয়</span></span><button class="link-btn" type="button" data-add-card="tech">' + ui.icon('plus') + 'টেক</button></span>' +
            '<div class="stack" data-tech>' + (p.tech.length ? p.tech : [null]).map(function (r) { return card('tech', r); }).join('') + '</div></div>' +
            '<div class="section"><span class="section-title"><span>এনভায়রনমেন্ট <span class="hint">সার্ভারে যা চলে</span></span><button class="link-btn" type="button" data-add-dep>' + ui.icon('plus') + 'এনভায়রনমেন্ট</button></span>' +
            '<div class="stack" data-deps>' + p.deployments.map(envBlock).join('') + '</div></div>' +
            '<p class="small muted">আপগ্রেড হলে কার্ডে "নতুন ভার্সন" দিয়ে যে তারিখ থেকে চলছে সেটাসহ যোগ করুন; সবচেয়ে নতুন তারিখের ভার্সনটাই এখনকার ভার্সন। ভুল লেখা ঠিক করতে সারিটাই বদলে দিন।</p>' +
            '<details class="fold"' + (hasMore ? ' open' : '') + '><summary>আরও তথ্য</summary>' +
            '<div class="form-grid">' +
            '<label class="field"><span>দায়িত্বে</span><input type="text" name="owner" value="' + esc(p.owner) + '" list="dl-owners"></label>' +
            '<label class="field"><span>ট্যাগ</span><input type="text" name="tags" value="' + esc(p.tags.join(', ')) + '" placeholder="client, payment"></label>' +
            '</div>' +
            '<label class="field"><span>রিপো বা লিংক</span><input type="text" name="repo" value="' + esc(p.repo) + '" placeholder="https://github.com/…"></label>' +
            '<label class="field"><span>নোট</span><textarea class="prose" name="note" rows="2">' + esc(p.note) + '</textarea></label>' +
            '<label class="check"><input type="checkbox" name="archived"' + (p.lifecycle === 'archived' ? ' checked' : '') + '>আর্কাইভ করা (ড্যাশবোর্ডের হিসাবে ধরা হবে না)</label>' +
            '</details>' +
            '<p class="notice s-eol" data-error hidden></p>';
        foot.innerHTML =
            (current ? '<button class="btn btn-ghost btn-sm btn-danger" type="button" data-delete>' + ui.icon('trash') + 'মুছুন</button>' : '<span></span>') +
            '<span class="row"><button class="btn" type="button" data-cancel>বাতিল</button><button class="btn btn-primary" type="submit">সেভ করুন</button></span>';
        ui.$$('[data-card]', body).forEach(function (c) { checkCard(c); markCurrent(c); });
        form.elements.name.focus();
    }

    // কার্ড থেকে {product, versions}; সমস্যা থাকলে error-এ বার্তা
    function readCards(container, problems) {
        const out = [];
        container.querySelectorAll('[data-card]').forEach(function (c) {
            const text = c.querySelector('[data-k="product"]').value.trim();
            const versions = [];
            c.querySelectorAll('[data-ver]').forEach(function (r) {
                const version = r.querySelector('[data-k="version"]').value.trim();
                const date = r.querySelector('[data-k="date"]').value;
                if (!version) return;
                if (!date) problems.push('প্রতিটা ভার্সনের তারিখ দিন।');
                versions.push({ version: version, date: date });
            });
            if (!text && !versions.length) return;
            if (!text) problems.push('প্রতিটা কার্ডে প্রোডাক্টের নাম লিখুন।');
            if (markDuplicates(c)) problems.push('একই তারিখে একাধিক ভার্সন দেওয়া যাবে না।');
            const product = ui.findProductByText(P.store.get(), c.dataset.kind, text);
            out.push({ product: product ? product.id : P.slug(text), versions: versions });
        });
        return out;
    }

    function collect(problems) {
        const el = form.elements;
        return {
            name: el.name.value.trim(),
            repo: el.repo.value.trim(),
            owner: el.owner.value.trim(),
            tags: el.tags.value,
            lifecycle: el.archived.checked ? 'archived' : 'active',
            note: el.note.value.trim(),
            tech: readCards(body.querySelector('[data-tech]'), problems),
            deployments: Array.prototype.map.call(body.querySelectorAll('[data-dep]'), function (b) {
                return {
                    name: b.querySelector('[data-k="name"]').value.trim(),
                    stack: readCards(b.querySelector('[data-stack]'), problems)
                };
            })
        };
    }

    function showError(msg) {
        const e = body.querySelector('[data-error]');
        e.textContent = msg;
        e.hidden = false;
        e.scrollIntoView({ block: 'nearest' });
    }

    function render() {
        if (editing) {
            const blank = { name: '', repo: '', owner: '', tags: [], lifecycle: 'active', note: '', tech: [], deployments: [{ name: P.DEPLOYMENT_NAMES[0], stack: [] }] };
            renderEdit(current ? find(current) || blank : blank);
        } else {
            const p = find(current);
            if (!p) return $el.close();
            renderView(p);
        }
    }

    // id = null হলে নতুন প্রজেক্ট
    ui.openProject = function (id, opts) {
        current = id && find(id) ? id : null;
        editing = !current || !!(opts && opts.edit);
        render();
        if (!$el.open) $el.showModal();
        body.scrollTop = 0;
        if (!editing) body.focus({ preventScroll: true });
    };

    ui.bindDialog($el, function () {
        current = null;
        editing = false;
        const q = new URLSearchParams(location.search);
        if (q.has('open') || q.has('new')) {
            q.delete('open');
            q.delete('new');
            const s = q.toString();
            history.replaceState(null, '', location.pathname + (s ? '?' + s : ''));
        }
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        const problems = [];
        const input = collect(problems);
        if (!input.name) return showError('প্রজেক্টের নাম লিখুন।');
        if (problems.length) return showError(P.unique(problems).join(' '));
        const names = input.deployments.map(function (d) { return d.name || 'production'; });
        if (P.unique(names).length !== names.length) return showError('একই নামের দুটো এনভায়রনমেন্ট আছে। নাম আলাদা করুন।');
        const data = P.store.get();
        let id = current;
        if (!id) {
            const base = P.slug(input.name) || P.uid('project');
            id = base;
            let n = 2;
            while (data.projects.some(function (p) { return p.id === id; })) id = base + '-' + n++;
        }
        const project = P.normalizeProject(Object.assign({}, input, { id: id, updatedAt: today() }));
        const isNew = !current;
        P.store.update(function (next) {
            const i = next.projects.findIndex(function (p) { return p.id === id; });
            if (i === -1) next.projects.push(project);
            else next.projects[i] = project;
        });
        current = id;
        editing = false;
        render();
        ui.toast(isNew ? '"' + project.name + '" যোগ হয়েছে।' : 'সেভ হয়েছে।');
    });

    $el.addEventListener('click', function (e) {
        const t = e.target.closest('button');
        if (!t) return;
        if (t.hasAttribute('data-edit')) {
            editing = true;
            render();
        } else if (t.hasAttribute('data-cancel')) {
            if (!current) return $el.close();
            editing = false;
            render();
        } else if (t.hasAttribute('data-plan')) {
            ui.showPrompt('আপগ্রেড পরিকল্পনা', P.aiPrompts.plan(P.store.get(), '', { project: current }), find(current).name + '-এর কোন অংশ আগে আর কীভাবে আপগ্রেড করতে হবে, AI ধাপে ধাপে লিখে দেবে।');
        } else if (t.hasAttribute('data-delete')) {
            const p = find(current);
            if (!p) return;
            const next = P.clone(P.store.get());
            next.projects = next.projects.filter(function (x) { return x.id !== p.id; });
            P.store.apply(next, 'প্রজেক্ট মুছে ফেলা');
            $el.close();
            ui.undoToast('"' + p.name + '" মুছে ফেলা হয়েছে।');
        } else if (t.hasAttribute('data-add-card')) {
            const kind = t.dataset.addCard;
            const box = kind === 'tech' ? body.querySelector('[data-tech]') : t.closest('[data-dep]').querySelector('[data-stack]');
            box.insertAdjacentHTML('beforeend', card(kind));
            box.lastElementChild.querySelector('[data-k="product"]').focus();
        } else if (t.hasAttribute('data-remove-card')) {
            t.closest('[data-card]').remove();
        } else if (t.hasAttribute('data-add-version')) {
            const c = t.closest('[data-card]');
            t.insertAdjacentHTML('afterend', verRow(null, c.dataset.kind, ''));
            checkCard(c);
            markDuplicates(c);
            markCurrent(c);
            t.nextElementSibling.querySelector('[data-k="version"]').focus();
        } else if (t.hasAttribute('data-remove-ver')) {
            const c = t.closest('[data-card]');
            t.closest('[data-ver]').remove();
            markDuplicates(c);
            markCurrent(c);
        } else if (t.hasAttribute('data-add-dep')) {
            const taken = Array.prototype.map.call(body.querySelectorAll('[data-dep] [data-k="name"]'), function (i) { return i.value.trim(); });
            const name = P.deploymentNames(P.store.get()).filter(function (n) { return taken.indexOf(n) === -1; })[0] || '';
            body.querySelector('[data-deps]').insertAdjacentHTML('beforeend', envBlock({ name: name, stack: [] }));
        } else if (t.hasAttribute('data-remove-dep')) {
            t.closest('[data-dep]').remove();
        } else if (t.hasAttribute('data-fetch')) {
            fetchProduct(t.closest('[data-card]'), t);
        } else if (t.hasAttribute('data-copy-summary')) {
            ui.copy(P.upgradeSummaryText(P.store.get(), find(current))).then(function () {
                ui.toast('সারাংশ কপি হয়েছে। ইমেইল বা চ্যাটে পেস্ট করুন।');
            }, function () {
                ui.toast('কপি করা গেল না।', 'eol');
            });
        }
    });

    $el.addEventListener('input', function (e) {
        const err = body.querySelector('[data-error]');
        if (err) err.hidden = true;
        if (e.target.matches('[data-card] input[data-k="product"]')) checkCard(e.target.closest('[data-card]'));
        if (e.target.matches('[data-ver] input[data-k="version"]')) markCurrent(e.target.closest('[data-card]'));
    });

    $el.addEventListener('change', function (e) {
        if (e.target.matches('[data-ver] input[data-k="date"]')) {
            sortCard(e.target.closest('[data-card]'));
            e.target.focus();
        }
    });

    ui.onChange(function (e) {
        if ($el.open && !editing && e.detail && e.detail.source !== 'save') render();
    });
</script>
