<template>
    <aside class="sidebar" id="sidebar" aria-label="সাইডবার">
        <a class="brand" href="/">
            <span class="brand-mark"><Icon name="pulse" /></span>
            <span>{{ data.site.name }}<small>ভার্সন আর সাপোর্টের হিসাব</small></span>
        </a>

        <nav class="nav-group" aria-label="প্রধান মেনু">
            <template for="link in data.menu">
                <a class="nav-item" href="{{ link.href }}" aria-current="{{ route.path === link.href ? 'page' : null }}"><Icon name="{{ link.icon }}" /><span>{{ link.label }}</span><span class="count" data-count="{{ link.count }}"></span></a>
            </template>
        </nav>

        <div class="nav-group sidebar-foot">
            <button class="nav-item" type="button" data-action="data"><Icon name="database" />ডেটা<span class="count">import · export</span></button>
            <button class="nav-item" type="button" data-action="settings"><Icon name="settings" />সেটিংস</button>
        </div>
    </aside>
</template>
