<template>
    <div class="stack catalog-page" data-kind="{{ props.kind }}" style="gap: 1.5rem">
        <section class="intro">
            <div class="spread">
                <h1>{{ props.title }}</h1>
                <button class="btn btn-primary" type="button" data-new>+ নতুন প্রোডাক্ট</button>
            </div>
            <slot />
        </section>

        <section class="card">
            <div class="filters">
                <label class="field grow"><span>খুঁজুন</span><input type="search" data-f="q" placeholder="প্রোডাক্ট বা ভার্সন"></label>
                <label class="field"><span>ধরন</span><select data-f="category"></select></label>
                <label class="check"><input type="checkbox" data-f="used">শুধু প্রজেক্টে ব্যবহৃত</label>
                <label class="check"><input type="checkbox" data-f="old">শেষ হওয়া অব্যবহৃত ভার্সনও দেখান</label>
            </div>
            <p class="small muted" data-count></p>
            <div class="stack" data-list></div>
        </section>

        <dialog class="modal" data-editor>
            <form class="modal-form" novalidate>
                <div class="modal-head">
                    <h2 data-title>প্রোডাক্ট</h2>
                    <button class="btn btn-icon" type="button" data-close aria-label="বন্ধ করুন">✕</button>
                </div>
                <div class="modal-body">
                    <div class="form-grid">
                        <label class="field"><span>নাম *</span><input type="text" name="name" maxlength="60"></label>
                        <label class="field"><span>id (প্রজেক্টে এই নামে লেখা থাকে)</span><input type="text" name="id" maxlength="60" placeholder="নাম থেকে নিজে বসবে"></label>
                        <label class="field"><span>ধরন</span><select name="category"></select></label>
                        <label class="field"><span>অফিসিয়াল লিংক</span><input type="text" name="url" placeholder="https://…"></label>
                    </div>
                    <div class="notice">
                        <div class="form-grid" style="align-items: end">
                            <label class="field"><span>endoflife.date-এর নাম</span><input type="text" name="eolSlug" placeholder="যেমন php, laravel, nodejs"></label>
                            <div><button class="btn" type="button" data-fetch>endoflife.date থেকে তারিখ আনুন</button></div>
                        </div>
                        <p class="small muted" style="margin-top: 0.5rem">নামটা <a href="https://endoflife.date" rel="noopener" target="_blank">endoflife.date</a>-এর লিংকের শেষ অংশ, যেমন endoflife.date/<b>php</b>। আনলে নতুন ভার্সন যোগ হয় আর তারিখ হালনাগাদ হয়; আপনার নোট আর শর্ত থেকে যায়।</p>
                    </div>
                    <div class="stack">
                        <div class="spread">
                            <h3>ভার্সন</h3>
                            <button class="btn btn-small" type="button" data-add-version>+ ভার্সন যোগ করুন</button>
                        </div>
                        <p class="small muted">শুধু সাইকেল লিখুন, যেমন 8.3 বা 12। "সক্রিয় সাপোর্ট" মানে নতুন ফিচার আর বাগ ফিক্স; "সিকিউরিটি" মানে শুধু নিরাপত্তা আপডেট। শেষের তারিখ জানা না থাকলে পাশের ঘরে বলে দিন সাপোর্ট চলছে নাকি শেষ। "যা লাগে" ঘরে লিখুন যেমন <code>php 8.2-8.5, nodejs 20+</code>।</p>
                        <div class="tablewrap">
                            <table class="table ver-table">
                                <thead>
                                    <tr>
                                        <th>ভার্সন</th>
                                        <th>রিলিজ</th>
                                        <th>সক্রিয় সাপোর্ট পর্যন্ত</th>
                                        <th>সিকিউরিটি পর্যন্ত</th>
                                        <th>তারিখ না থাকলে</th>
                                        <th>LTS</th>
                                        <th>আনুমানিক</th>
                                        <th>যা লাগে</th>
                                        <th>নোট</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody data-versions></tbody>
                            </table>
                        </div>
                    </div>
                    <p class="notice s-critical" data-error hidden></p>
                </div>
                <div class="modal-foot">
                    <button class="btn btn-danger" type="button" data-delete>প্রোডাক্ট মুছুন</button>
                    <span class="row">
                        <button class="btn" type="button" data-close>বাতিল</button>
                        <button class="btn btn-primary" type="submit">সেভ করুন</button>
                    </span>
                </div>
            </form>
        </dialog>
    </div>
</template>

<script>
    const P = PHD;
    const ui = P.ui;
    const esc = P.esc;
    const kind = $el.dataset.kind;
    const listEl = $el.querySelector('[data-list]');
    const dialog = $el.querySelector('[data-editor]');
    const form = dialog.querySelector('form');
    const f = { q: '', category: '', used: false, old: false };
    let editing = null;

    function categories(data) {
        const map = Object.assign({}, P.CATEGORIES[kind]);
        data.catalog[kind].forEach(function (p) {
            if (!map[p.category]) map[p.category] = p.category;
        });
        return map;
    }

    function projectsLink(product, version, n) {
        if (!n) return '<span class="muted">—</span>';
        const href = P.url('/projects/?product=' + encodeURIComponent(kind + '|' + product) + (version ? '&version=' + encodeURIComponent(version) : ''));
        return '<a href="' + esc(href) + '">' + P.num(n) + 'টি প্রজেক্ট</a>';
    }

    function render() {
        const data = P.store.get();
        const cats = categories(data);
        const catSel = $el.querySelector('[data-f="category"]');
        catSel.innerHTML = ui.options(cats, f.category, 'সব ধরন');
        catSel.value = f.category;

        const usage = P.usage(P.analyze(data, { includeArchived: true }).rows);
        const needle = f.q.trim().toLowerCase();
        let shown = 0;
        const html = data.catalog[kind].map(function (product) {
            if (f.category && product.category !== f.category) return '';
            const rows = product.versions.map(function (v) {
                return { v: v, s: P.cycleStatus(v, data.settings), n: P.usageCount(usage, kind, product.id, v.version) };
            });
            const used = rows.filter(function (r) { return r.n; });
            if (f.used && !used.length) return '';
            if (needle && (product.name + ' ' + product.id + ' ' + product.versions.map(function (v) { return v.version; }).join(' ')).toLowerCase().indexOf(needle) === -1) return '';
            shown++;
            const visible = rows.filter(function (r) { return f.old || r.n || r.s.status !== 'eol'; });
            const totalUse = P.unique(Object.keys(usage).filter(function (k) { return k.indexOf(kind + '|' + product.id + '|') === 0; }).reduce(function (acc, k) { return acc.concat(usage[k].projects.map(function (p) { return p.id; })); }, [])).length;
            let worst = null;
            used.forEach(function (r) { if (!worst || P.statusRank(r.s.status) > P.statusRank(worst)) worst = r.s.status; });
            const body = visible.length
                ? '<div class="tablewrap"><table class="table"><thead><tr><th>ভার্সন</th><th>রিলিজ</th><th>সক্রিয় সাপোর্ট পর্যন্ত</th><th>সিকিউরিটি পর্যন্ত</th><th>অবস্থা</th><th>যা লাগে</th><th>ব্যবহার</th></tr></thead><tbody>' +
                  visible.map(function (r) {
                      const v = r.v;
                      return '<tr>' +
                          '<td><b>' + esc(v.version) + '</b>' + (v.lts ? ' <span class="pill">LTS</span>' : '') + (v.note ? '<br><span class="small muted">' + esc(v.note) + '</span>' : '') + '</td>' +
                          '<td class="num">' + (P.fmtDate(v.released) || '<span class="muted">—</span>') + '</td>' +
                          '<td class="num">' + (P.fmtDate(v.supportUntil) || '<span class="muted">—</span>') + '</td>' +
                          '<td class="num">' + (P.fmtDate(v.securityUntil) || '<span class="muted">' + esc(P.VERSION_STATES[v.state]) + '</span>') + (v.approx ? ' <span class="small muted">(আনুমানিক)</span>' : '') + '</td>' +
                          '<td>' + ui.pill(r.s.status) + (r.s.phase && r.s.status !== 'eol' ? '<br><span class="small muted">' + P.PHASE[r.s.phase] + '</span>' : '') + '</td>' +
                          '<td class="small">' + (esc(P.formatRequires(v.requires)) || '<span class="muted">—</span>') + '</td>' +
                          '<td class="small">' + projectsLink(product.id, v.version, r.n) + '</td>' +
                          '</tr>';
                  }).join('') + '</tbody></table></div>'
                : '<p class="small muted">দেখানোর মতো ভার্সন নেই। সব ভার্সন দেখতে উপরে "শেষ হওয়া অব্যবহৃত ভার্সনও দেখান" চালু করুন।</p>';
            const hidden = rows.length - visible.length;
            return (
                '<details class="product"' + (used.length ? ' open' : '') + '>' +
                '<summary><span class="product-name">' + esc(product.name) + '</span>' +
                '<span class="small muted">' + esc(cats[product.category] || product.category) + ' · ' + P.num(product.versions.length) + 'টি ভার্সন</span>' +
                (worst ? ui.pill(worst) : '') +
                '<span class="small product-use">' + projectsLink(product.id, '', totalUse) + '</span>' +
                '<button class="btn btn-small" type="button" data-edit="' + esc(product.id) + '">এডিট</button></summary>' +
                '<div class="product-body">' + body +
                (hidden ? '<p class="small muted">শেষ হওয়া ' + P.num(hidden) + 'টি অব্যবহৃত ভার্সন লুকানো আছে।</p>' : '') +
                (product.eolSlug ? '<p class="small muted">তারিখের উৎস: <a href="https://endoflife.date/' + esc(product.eolSlug) + '" rel="noopener" target="_blank">endoflife.date/' + esc(product.eolSlug) + '</a></p>' : '') +
                '</div></details>'
            );
        }).join('');
        listEl.innerHTML = html || '<div class="empty"><p>এই ফিল্টারে কোনো প্রোডাক্ট নেই।</p></div>';
        $el.querySelector('[data-count]').textContent = P.num(shown) + 'টি প্রোডাক্ট। যে প্রোডাক্ট কোনো প্রজেক্টে ব্যবহার হচ্ছে, সেটা খোলা থাকে।';
    }

    /* ---------- এডিটর ---------- */

    function versionRow(v) {
        v = v || { version: '', released: '', supportUntil: '', securityUntil: '', lts: false, state: '', approx: false, requires: [], note: '' };
        return (
            '<tr data-row>' +
            '<td><input type="text" data-k="version" value="' + esc(v.version) + '" placeholder="8.3" style="min-width: 4.5rem"></td>' +
            '<td><input type="date" data-k="released" value="' + esc(v.released) + '"></td>' +
            '<td><input type="date" data-k="supportUntil" value="' + esc(v.supportUntil) + '"></td>' +
            '<td><input type="date" data-k="securityUntil" value="' + esc(v.securityUntil) + '"></td>' +
            '<td><select data-k="state">' + ui.options(P.VERSION_STATES, v.state) + '</select></td>' +
            '<td><input type="checkbox" data-k="lts"' + (v.lts ? ' checked' : '') + ' aria-label="LTS"></td>' +
            '<td><input type="checkbox" data-k="approx"' + (v.approx ? ' checked' : '') + ' aria-label="আনুমানিক"></td>' +
            '<td><input type="text" data-k="requires" value="' + esc(P.formatRequires(v.requires)) + '" placeholder="php 8.2+" style="min-width: 9rem"></td>' +
            '<td><input type="text" data-k="note" value="' + esc(v.note) + '" style="min-width: 9rem"></td>' +
            '<td><button class="btn btn-small btn-icon" type="button" data-remove aria-label="ভার্সন সরান">✕</button></td>' +
            '</tr>'
        );
    }

    function fillVersions(versions) {
        dialog.querySelector('[data-versions]').innerHTML = (versions.length ? versions : [null]).map(versionRow).join('');
    }

    function collect() {
        const el = form.elements;
        return {
            id: P.slug(el.id.value || el.name.value),
            name: el.name.value.trim(),
            category: el.category.value,
            eolSlug: el.eolSlug.value.trim(),
            url: el.url.value.trim(),
            versions: ui.$$('[data-row]', dialog).map(function (tr) {
                const get = function (k) { return tr.querySelector('[data-k="' + k + '"]'); };
                return {
                    version: get('version').value.trim(),
                    released: get('released').value,
                    supportUntil: get('supportUntil').value,
                    securityUntil: get('securityUntil').value,
                    state: get('state').value,
                    lts: get('lts').checked,
                    approx: get('approx').checked,
                    requires: get('requires').value,
                    note: get('note').value.trim()
                };
            }).filter(function (v) { return v.version; })
        };
    }

    function error(msg) {
        const e = dialog.querySelector('[data-error]');
        e.textContent = msg || '';
        e.hidden = !msg;
    }

    function openEditor(product) {
        const data = P.store.get();
        editing = product ? product.id : null;
        const p = product || { id: '', name: '', category: Object.keys(P.CATEGORIES[kind])[0], eolSlug: '', url: '', versions: [] };
        dialog.querySelector('[data-title]').textContent = editing ? p.name + ' এডিট' : 'নতুন প্রোডাক্ট (' + P.KIND_LABEL[kind] + ')';
        form.elements.name.value = p.name;
        form.elements.id.value = p.id;
        form.elements.id.disabled = !!editing;
        form.elements.category.innerHTML = ui.options(categories(data), p.category);
        form.elements.eolSlug.value = p.eolSlug;
        form.elements.url.value = p.url;
        fillVersions(p.versions);
        dialog.querySelector('[data-delete]').hidden = !editing;
        error('');
        dialog.showModal();
        form.elements.name.focus();
    }

    function close() {
        dialog.close();
        editing = null;
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        const input = collect();
        if (!input.name) return error('প্রোডাক্টের নাম লিখুন।');
        if (!input.id) return error('id বানানো গেল না। নামে অন্তত একটা অক্ষর বা সংখ্যা রাখুন।');
        const seen = {};
        for (const v of input.versions) {
            if (seen[v.version]) return error('ভার্সন ' + v.version + ' দুবার আছে।');
            seen[v.version] = true;
            if (v.supportUntil && v.securityUntil && v.securityUntil < v.supportUntil) return error(v.version + ': সিকিউরিটি সাপোর্টের তারিখ সক্রিয় সাপোর্টের আগে হতে পারে না।');
        }
        const data = P.store.get();
        if (!editing && P.findProduct(data, kind, input.id)) return error('"' + input.id + '" id-র প্রোডাক্ট আগেই আছে। অন্য id দিন, বা সেটাই এডিট করুন।');
        const product = P.normalizeProduct(Object.assign(input, { id: editing || input.id }), kind);
        P.store.update(function (next) {
            const list = next.catalog[kind];
            const i = list.findIndex(function (p) { return p.id === product.id; });
            if (i === -1) list.push(product);
            else list[i] = product;
        });
        close();
        ui.toast('"' + product.name + '" সেভ হয়েছে।');
    });

    dialog.addEventListener('click', function (e) {
        if (e.target === dialog) return close();
        const t = e.target.closest('button');
        if (!t) return;
        if (t.hasAttribute('data-close')) close();
        else if (t.hasAttribute('data-remove')) t.closest('tr').remove();
        else if (t.hasAttribute('data-add-version')) dialog.querySelector('[data-versions]').insertAdjacentHTML('afterbegin', versionRow());
    });

    dialog.addEventListener('cancel', function () {
        editing = null;
    });

    dialog.querySelector('[data-fetch]').addEventListener('click', function (e) {
        const btn = e.currentTarget;
        const slug = form.elements.eolSlug.value.trim() || P.slug(form.elements.name.value);
        if (!slug) return error('endoflife.date-এর নাম লিখুন।');
        btn.disabled = true;
        btn.textContent = 'আনা হচ্ছে…';
        error('');
        P.fetchEndOfLife(slug)
            .then(function (result) {
                const current = P.normalizeProduct(Object.assign(collect(), { id: editing || P.slug(form.elements.id.value || form.elements.name.value || slug) }), kind);
                const fresh = P.productFromEndOfLife(result, kind, { id: current ? current.id : slug });
                const merged = current ? P.mergeProduct(current, fresh) : fresh;
                const before = current ? current.versions.length : 0;
                if (!form.elements.name.value.trim()) form.elements.name.value = fresh.name;
                if (!form.elements.url.value.trim()) form.elements.url.value = fresh.url;
                form.elements.eolSlug.value = slug;
                fillVersions(merged.versions);
                ui.toast(fresh.versions.length + 'টি ভার্সনের তারিখ এসেছে; নতুন যোগ হয়েছে ' + (merged.versions.length - before) + 'টি। দেখে নিয়ে সেভ করুন।');
            })
            .catch(function (err) {
                error(err.message === 'not-found' ? 'endoflife.date-এ "' + slug + '" নামে কিছু পাওয়া যায়নি।' : 'আনা গেল না। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।');
            })
            .finally(function () {
                btn.disabled = false;
                btn.textContent = 'endoflife.date থেকে তারিখ আনুন';
            });
    });

    dialog.querySelector('[data-delete]').addEventListener('click', function () {
        const data = P.store.get();
        const product = P.findProduct(data, kind, editing);
        if (!product) return;
        const usedBy = data.projects.filter(function (p) {
            const refs = kind === 'tech' ? p.tech : p.deployments.reduce(function (a, d) { return a.concat(d.stack); }, []);
            return refs.some(function (r) { return r.product === product.id; });
        }).length;
        const msg = usedBy ? '"' + product.name + '" ' + usedBy + 'টি প্রজেক্টে ব্যবহার হচ্ছে। মুছলে সেগুলোতে "ক্যাটালগে নেই" দেখাবে। তবু মুছবেন?' : '"' + product.name + '" মুছবেন?';
        if (!confirm(msg)) return;
        const next = P.clone(data);
        next.catalog[kind] = next.catalog[kind].filter(function (p) { return p.id !== product.id; });
        P.store.apply(next, 'প্রোডাক্ট মুছে ফেলা');
        close();
        ui.undoToast('"' + product.name + '" মুছে ফেলা হয়েছে।');
    });

    /* ---------- তালিকার ঘটনা ---------- */

    listEl.addEventListener('click', function (e) {
        const b = e.target.closest('[data-edit]');
        if (!b) return;
        e.preventDefault();
        openEditor(P.findProduct(P.store.get(), kind, b.dataset.edit));
    });

    $el.querySelector('[data-new]').addEventListener('click', function () {
        openEditor(null);
    });

    $el.querySelector('[data-f="category"]').addEventListener('change', function (e) { f.category = e.target.value; render(); });
    $el.querySelector('[data-f="used"]').addEventListener('change', function (e) { f.used = e.target.checked; render(); });
    $el.querySelector('[data-f="old"]').addEventListener('change', function (e) { f.old = e.target.checked; render(); });
    let typing;
    $el.querySelector('[data-f="q"]').addEventListener('input', function (e) {
        clearTimeout(typing);
        typing = setTimeout(function () { f.q = e.target.value; render(); }, 150);
    });

    P.store.ready().then(function () {
        render();
        const editId = ui.query().get('edit');
        const product = editId && P.findProduct(P.store.get(), kind, editId);
        if (product) openEditor(product);
        else if (ui.query().get('new')) {
            openEditor(null);
            const name = ui.query().get('name');
            if (name) form.elements.name.value = name;
        }
    });
    ui.onChange(function () {
        if (!dialog.open) render();
    });
</script>
