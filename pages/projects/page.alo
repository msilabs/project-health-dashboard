<head>
    <title>প্রজেক্ট | {{ data.site.name }}</title>
</head>

<template>
    <div class="page-head">
        <div>
            <h1>প্রজেক্ট</h1>
            <p id="count">&nbsp;</p>
        </div>
        <div class="actions">
            <button class="btn btn-primary" type="button" data-action="new-project"><Icon name="plus" />নতুন প্রজেক্ট</button>
        </div>
    </div>

    <section class="card">
        <div class="toolbar">
            <label class="search"><Icon name="search" /><input type="search" id="f-q" placeholder="নাম, ট্যাগ বা ভার্সন খুঁজুন" aria-label="খুঁজুন"></label>
            <div class="segmented" id="status" role="group" aria-label="অবস্থা"></div>
            <span class="spacer"></span>
            <span id="chips" class="row"></span>
            <select id="f-dep" aria-label="এনভায়রনমেন্ট"></select>
            <label class="check"><input type="checkbox" id="f-archived">আর্কাইভ দেখান</label>
        </div>
        <div class="skeleton" id="skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <div class="tablewrap" id="tablewrap" hidden>
            <table class="table">
                <thead>
                    <tr>
                        <th>প্রজেক্ট</th>
                        <th>অবস্থা</th>
                        <th>মূল কারণ</th>
                        <th class="hide-sm">এনভায়রনমেন্ট</th>
                        <th class="hide-sm" aria-label="খুলুন"></th>
                    </tr>
                </thead>
                <tbody id="rows"></tbody>
            </table>
        </div>
        <div class="empty" id="empty" hidden>
            <p id="empty-text"></p>
        </div>
    </section>
</template>

<script>
    const P = PHD;
    const ui = P.ui;
    const esc = P.esc;
    // product আর version আসে ক্যাটালগের লিংক থেকে; এখানে শুধু chip হিসেবে দেখায়
    const KEYS = ['status', 'dep', 'product', 'version', 'archived', 'q'];
    const query = ui.query();
    const f = {};
    KEYS.forEach(function (k) { f[k] = query.get(k) || ''; });

    function versionOf(x) {
        return x.cycle ? x.cycle.version : P.cleanVersion(x.version);
    }

    function compute(data) {
        const a = P.analyze(data, { includeArchived: true, deployment: f.dep || undefined });
        const needle = f.q.trim().toLowerCase();
        const parts = f.product ? f.product.split('|') : null;
        const rows = a.rows.filter(function (r) {
            const p = r.project;
            if (!f.archived && p.lifecycle === 'archived') return false;
            if (f.dep && !p.deployments.some(function (d) { return d.name === f.dep; })) return false;
            if (parts && !r.items.some(function (x) { return x.kind === parts[0] && x.product === parts[1] && (!f.version || versionOf(x) === f.version); })) return false;
            if (needle) {
                const hay = [p.name, p.repo, p.owner, p.tags.join(' '), p.note].concat(r.items.map(function (x) { return x.label; })).join(' ').toLowerCase();
                if (hay.indexOf(needle) === -1) return false;
            }
            return true;
        });
        const counts = {};
        P.STATUS_ORDER.forEach(function (s) { counts[s] = 0; });
        rows.forEach(function (r) { counts[r.status]++; });
        return { all: rows, rows: f.status ? rows.filter(function (r) { return r.status === f.status; }) : rows, counts: counts };
    }

    function fill(sel, map, value, empty) {
        if (value && map[value] === undefined) map[value] = value;
        const el = ui.$(sel);
        el.innerHTML = ui.options(map, value, empty);
        el.value = value;
    }

    function renderFilters(data, counts, total) {
        ui.$('#status').innerHTML = '<button type="button" data-status="" aria-pressed="' + !f.status + '">সব <span class="count">' + P.num(total) + '</span></button>' +
            P.STATUS_ORDER.map(function (s) {
                return '<button type="button" data-status="' + s + '" aria-pressed="' + (f.status === s) + '"><span class="dot s-' + s + '"></span>' + P.STATUS[s].label + ' <span class="count">' + P.num(counts[s]) + '</span></button>';
            }).join('');

        const deps = {};
        P.deploymentNames(data).forEach(function (n) { deps[n] = n; });
        fill('#f-dep', deps, f.dep, 'সব এনভায়রনমেন্ট');
        ui.$('#f-archived').checked = !!f.archived;
        ui.$('#f-q').value = f.q;

        let chip = '';
        if (f.product) {
            const parts = f.product.split('|');
            const product = P.KINDS.indexOf(parts[0]) !== -1 ? P.findProduct(data, parts[0], parts[1]) : null;
            const label = (product ? product.name : parts[1]) + (f.version ? ' ' + f.version : '');
            chip = '<span class="chip">' + esc(label) + '<button type="button" data-clear-product aria-label="এই ফিল্টার সরান">' + ui.icon('x') + '</button></span>';
        }
        ui.$('#chips').innerHTML = chip;
    }

    // প্রতিটা environment-এর সবচেয়ে খারাপ অবস্থা; টেকের জন্য আলাদা একটা
    function envPills(r) {
        const groups = [{ name: 'টেক', items: r.items.filter(function (x) { return x.kind === 'tech'; }) }].concat(
            r.project.deployments.filter(function (d) { return !f.dep || d.name === f.dep; }).map(function (d) {
                return { name: d.name, items: r.items.filter(function (x) { return x.kind === 'env' && x.deployment === d.name; }) };
            })
        ).filter(function (g) { return g.items.length; });
        if (!groups.length) return '<span class="muted">—</span>';
        return '<div class="env-pills">' + groups.map(function (g) {
            let worst = 'unknown';
            g.items.forEach(function (x) { if (P.statusRank(x.status) > P.statusRank(worst)) worst = x.status; });
            const tip = g.items.map(function (x) { return x.label + ': ' + x.text; }).join('\n');
            return '<span class="env-pill s-' + worst + '" data-tip="' + esc(tip) + '"><span class="dot"></span>' + esc(g.name) + '</span>';
        }).join('') + '</div>';
    }

    function rowHtml(r) {
        const p = r.project;
        const sub = [p.owner].concat(p.tags).filter(Boolean).join(' · ');
        return (
            '<tr class="clickable" data-id="' + esc(p.id) + '">' +
            '<td><div class="who">' + ui.avatar(p.name) + '<div><b>' + esc(p.name) + (p.lifecycle === 'archived' ? ' <span class="tag">' + esc(P.LIFECYCLES.archived) + '</span>' : '') + '</b>' + (sub ? '<span>' + esc(sub) + '</span>' : '') + '</div></div></td>' +
            '<td>' + ui.badge(r.status) + '</td>' +
            '<td class="small">' + esc(r.reason) + (r.issues.length ? '<br><span class="muted">' + P.num(r.issues.length) + 'টি অমিল</span>' : '') + '</td>' +
            '<td class="hide-sm">' + envPills(r) + '</td>' +
            '<td class="hide-sm arrow">' + ui.icon('chevron') + '</td>' +
            '</tr>'
        );
    }

    function render() {
        const data = P.store.get();
        const c = compute(data);
        renderFilters(data, c.counts, c.all.length);
        ui.$('#rows').innerHTML = c.rows.map(rowHtml).join('');
        ui.$('#skeleton').hidden = true;
        ui.$('#tablewrap').hidden = c.rows.length === 0;
        ui.$('#empty').hidden = c.rows.length > 0;
        ui.$('#empty-text').textContent = data.projects.length ? 'এই ফিল্টারে কোনো প্রজেক্ট নেই।' : 'এখনো কোনো প্রজেক্ট নেই। উপরের "নতুন প্রজেক্ট" দিয়ে যোগ করুন, বা সাইডবারের "ডেটা" থেকে import করুন।';
        ui.$('#count').textContent = P.num(c.rows.length) + 'টি প্রজেক্ট' + (f.dep ? ' · অবস্থা হিসাব হয়েছে শুধু ' + f.dep + '-এর সার্ভার ধরে' : '');
        const q = Object.assign({}, f);
        const open = ui.query();
        if (open.get('open')) q.open = open.get('open');
        ui.setQuery(q);
    }

    function set(k, v) {
        f[k] = v;
        render();
    }

    ui.$('#status').addEventListener('click', function (e) {
        const b = e.target.closest('[data-status]');
        if (b) set('status', b.dataset.status);
    });
    ui.$('#f-dep').addEventListener('change', function (e) { set('dep', e.target.value); });
    ui.$('#f-archived').addEventListener('change', function (e) { set('archived', e.target.checked ? '1' : ''); });
    let typing;
    ui.$('#f-q').addEventListener('input', function (e) {
        clearTimeout(typing);
        typing = setTimeout(function () { set('q', e.target.value); }, 150);
    });
    ui.$('#chips').addEventListener('click', function (e) {
        if (!e.target.closest('[data-clear-product]')) return;
        f.product = '';
        f.version = '';
        render();
    });
    ui.$('#rows').addEventListener('click', function (e) {
        const tr = e.target.closest('tr[data-id]');
        if (tr) ui.openProject(tr.dataset.id);
    });

    P.store.ready().then(function () {
        render();
        if (query.get('open')) ui.openProject(query.get('open'));
        else if (query.get('new')) ui.openProject(null);
    });
    ui.onChange(render);
</script>
