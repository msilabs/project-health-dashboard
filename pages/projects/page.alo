<head>
    <title>প্রজেক্ট | {{ data.site.name }}</title>
</head>

<template>
    <div class="page-head">
        <div>
            <h1>প্রজেক্ট</h1>
            <p id="count">ডেটা লোড হচ্ছে…</p>
        </div>
        <div class="actions">
            <button class="btn btn-primary" type="button" id="add"><Icon name="plus" />নতুন প্রজেক্ট</button>
        </div>
    </div>

    <section class="card">
        <div class="toolbar">
            <label class="search"><Icon name="search" /><input type="search" id="f-q" placeholder="নাম, ট্যাগ বা ভার্সন খুঁজুন" aria-label="খুঁজুন"></label>
            <div class="segmented" id="status" role="group" aria-label="অবস্থা"></div>
            <span class="spacer"></span>
            <select id="f-dep" aria-label="Environment"></select>
            <button class="btn btn-sm" type="button" id="more" aria-expanded="false"><Icon name="filter" />ফিল্টার<span class="counter" id="more-count" hidden></span></button>
        </div>
        <div class="more-filters" id="more-panel" hidden>
            <select id="f-product" aria-label="প্রোডাক্ট"></select>
            <select id="f-version" aria-label="ভার্সন"></select>
            <select id="f-owner" aria-label="Owner"></select>
            <select id="f-tag" aria-label="ট্যাগ"></select>
            <select id="f-life" aria-label="প্রজেক্টের ধাপ"></select>
            <button class="btn btn-ghost btn-sm" type="button" id="reset">সব ফিল্টার মুছুন</button>
        </div>
        <div class="tablewrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>প্রজেক্ট</th>
                        <th>অবস্থা</th>
                        <th>মূল কারণ</th>
                        <th class="hide-sm">স্ট্যাক</th>
                    </tr>
                </thead>
                <tbody id="rows"></tbody>
            </table>
        </div>
        <div class="empty" id="empty" hidden>
            <p id="empty-text"></p>
        </div>
    </section>
</template>

<script>
    const P = PHD;
    const ui = P.ui;
    const esc = P.esc;
    const KEYS = ['status', 'dep', 'product', 'version', 'owner', 'tag', 'life', 'q'];
    const MORE = ['product', 'version', 'owner', 'tag', 'life'];
    const query = ui.query();
    const f = {};
    KEYS.forEach(function (k) { f[k] = query.get(k) || ''; });

    function versionOf(x) {
        return x.cycle ? x.cycle.version : P.cleanVersion(x.version);
    }

    function compute(data) {
        const a = P.analyze(data, { includeArchived: true, deployment: f.dep || undefined });
        const needle = f.q.trim().toLowerCase();
        const parts = f.product ? f.product.split('|') : null;
        const rows = a.rows.filter(function (r) {
            const p = r.project;
            if (!f.life && p.lifecycle === 'archived') return false;
            if (f.life && f.life !== 'all' && p.lifecycle !== f.life) return false;
            if (f.dep && !p.deployments.some(function (d) { return d.name === f.dep; })) return false;
            if (f.owner && p.owner !== f.owner) return false;
            if (f.tag && p.tags.indexOf(f.tag) === -1) return false;
            if (parts && !r.items.some(function (x) { return x.kind === parts[0] && x.product === parts[1] && (!f.version || versionOf(x) === f.version); })) return false;
            if (needle) {
                const hay = [p.name, p.repo, p.owner, p.tags.join(' '), p.note].concat(r.items.map(function (x) { return x.label; })).join(' ').toLowerCase();
                if (hay.indexOf(needle) === -1) return false;
            }
            return true;
        });
        const counts = {};
        P.STATUS_ORDER.forEach(function (s) { counts[s] = 0; });
        rows.forEach(function (r) { counts[r.status]++; });
        return { all: rows, rows: f.status ? rows.filter(function (r) { return r.status === f.status; }) : rows, counts: counts };
    }

    function fill(sel, map, value, empty) {
        if (value && map[value] === undefined) map[value] = value;
        const el = ui.$(sel);
        el.innerHTML = ui.options(map, value, empty);
        el.value = value;
    }

    function renderFilters(data, counts, total) {
        ui.$('#status').innerHTML = '<button type="button" data-status="" aria-pressed="' + !f.status + '">সব <span class="count">' + P.num(total) + '</span></button>' +
            P.STATUS_ORDER.map(function (s) {
                return '<button type="button" data-status="' + s + '" aria-pressed="' + (f.status === s) + '"><span class="dot s-' + s + '"></span>' + P.STATUS[s].label + ' <span class="count">' + P.num(counts[s]) + '</span></button>';
            }).join('');

        const deps = {};
        data.settings.deploymentNames.forEach(function (n) { deps[n] = n; });
        data.projects.forEach(function (p) { p.deployments.forEach(function (d) { deps[d.name] = d.name; }); });
        fill('#f-dep', deps, f.dep, 'সব environment');

        const owners = {};
        const tags = {};
        const used = { tech: {}, env: {} };
        const versions = {};
        P.analyze(data, { includeArchived: true }).rows.forEach(function (r) {
            if (r.project.owner) owners[r.project.owner] = r.project.owner;
            r.project.tags.forEach(function (t) { tags[t] = t; });
            r.items.forEach(function (x) {
                used[x.kind][x.product] = x.productName;
                if (x.version) (versions[x.kind + '|' + x.product] = versions[x.kind + '|' + x.product] || {})[versionOf(x)] = true;
            });
        });
        fill('#f-owner', owners, f.owner, 'সব owner');
        fill('#f-tag', tags, f.tag, 'সব ট্যাগ');
        fill('#f-life', { all: 'আর্কাইভসহ সব', active: P.LIFECYCLES.active, maintenance: P.LIFECYCLES.maintenance, archived: P.LIFECYCLES.archived }, f.life, 'সক্রিয় ও রক্ষণাবেক্ষণ');
        let html = '<option value="">সব প্রোডাক্ট</option>';
        P.KINDS.forEach(function (kind) {
            const ids = Object.keys(used[kind]).sort(function (a, b) { return used[kind][a].localeCompare(used[kind][b]); });
            if (ids.length) html += '<optgroup label="' + P.KIND_LABEL[kind] + '">' + ids.map(function (id) { return '<option value="' + esc(kind + '|' + id) + '">' + esc(used[kind][id]) + '</option>'; }).join('') + '</optgroup>';
        });
        ui.$('#f-product').innerHTML = html;
        ui.$('#f-product').value = f.product;
        const vmap = {};
        P.sortVersionsDesc(Object.keys(versions[f.product] || {})).forEach(function (v) { vmap[v] = v; });
        fill('#f-version', vmap, f.version, 'সব ভার্সন');
        ui.$('#f-version').disabled = !f.product;
        ui.$('#f-q').value = f.q;

        const active = MORE.filter(function (k) { return f[k]; }).length;
        ui.$('#more-count').hidden = !active;
        ui.$('#more-count').textContent = P.num(active);
        if (active) ui.$('#more-panel').hidden = false;
        ui.$('#more').setAttribute('aria-expanded', String(!ui.$('#more-panel').hidden));
    }

    function stack(r) {
        const labels = r.items.filter(function (x) { return x.version; }).map(function (x) { return x.label; });
        if (!labels.length) return '<span class="muted">—</span>';
        return '<span class="small muted">' + esc(labels.slice(0, 3).join(', ')) + (labels.length > 3 ? ' +' + P.num(labels.length - 3) : '') + '</span>';
    }

    function rowHtml(r) {
        const p = r.project;
        const sub = [p.owner].concat(p.tags).filter(Boolean);
        return (
            '<tr class="clickable" data-id="' + esc(p.id) + '">' +
            '<td><div class="cell-title"><b>' + esc(p.name) + '</b>' + (sub.length || p.lifecycle !== 'active' ? '<span class="small muted">' + esc(sub.join(' · ')) + (p.lifecycle !== 'active' ? ' <span class="tag">' + esc(P.LIFECYCLES[p.lifecycle]) + '</span>' : '') + '</span>' : '') + '</div></td>' +
            '<td>' + ui.badge(r.status) + '</td>' +
            '<td class="small">' + esc(r.reason) + (r.issues.length ? '<br><span class="muted">' + P.num(r.issues.length) + 'টি অমিল</span>' : '') + '</td>' +
            '<td class="hide-sm">' + stack(r) + '</td>' +
            '</tr>'
        );
    }

    function render() {
        const data = P.store.get();
        const c = compute(data);
        renderFilters(data, c.counts, c.all.length);
        ui.$('#rows').innerHTML = c.rows.map(rowHtml).join('');
        ui.$('#empty').hidden = c.rows.length > 0;
        ui.$('#empty-text').textContent = data.projects.length ? 'এই ফিল্টারে কোনো প্রজেক্ট নেই।' : 'এখনো কোনো প্রজেক্ট নেই। "নতুন প্রজেক্ট" দিয়ে যোগ করুন, বা ডেটা মেনু থেকে import করুন।';
        ui.$('#count').textContent = P.num(c.rows.length) + 'টি প্রজেক্ট' + (f.dep ? ' · অবস্থা হিসাব হয়েছে শুধু ' + f.dep + '-এর সার্ভার ধরে' : '');
        const q = Object.assign({}, f);
        const open = ui.query();
        if (open.get('open')) q.open = open.get('open');
        ui.setQuery(q);
    }

    function set(k, v) {
        f[k] = v;
        if (k === 'product') f.version = '';
        render();
    }

    ui.$('#status').addEventListener('click', function (e) {
        const b = e.target.closest('[data-status]');
        if (b) set('status', b.dataset.status);
    });
    [['#f-dep', 'dep'], ['#f-product', 'product'], ['#f-version', 'version'], ['#f-owner', 'owner'], ['#f-tag', 'tag'], ['#f-life', 'life']].forEach(function (pair) {
        ui.$(pair[0]).addEventListener('change', function (e) { set(pair[1], e.target.value); });
    });
    let typing;
    ui.$('#f-q').addEventListener('input', function (e) {
        clearTimeout(typing);
        typing = setTimeout(function () { set('q', e.target.value); }, 150);
    });
    ui.$('#more').addEventListener('click', function () {
        const panel = ui.$('#more-panel');
        panel.hidden = !panel.hidden;
        ui.$('#more').setAttribute('aria-expanded', String(!panel.hidden));
    });
    ui.$('#reset').addEventListener('click', function () {
        KEYS.forEach(function (k) { f[k] = ''; });
        ui.$('#more-panel').hidden = true;
        render();
    });
    ui.$('#rows').addEventListener('click', function (e) {
        const tr = e.target.closest('tr[data-id]');
        if (tr) ui.openProject(tr.dataset.id);
    });
    ui.$('#add').addEventListener('click', function () { ui.openProject(null); });

    P.store.ready().then(function () {
        render();
        if (query.get('open')) ui.openProject(query.get('open'));
        else if (query.get('new')) ui.openProject(null);
    });
    ui.onChange(render);
</script>
