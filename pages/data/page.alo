<head>
    <title>ডেটা | {{ data.site.name }}</title>
</head>

<template>
    <section class="intro">
        <h1>ডেটা</h1>
        <p>সব ডেটা থাকে শুধু এই ব্রাউজারে। ব্যাকআপ রাখতে, অন্য কম্পিউটারে নিতে বা টিমের সাথে শেয়ার করতে JSON export করুন; দরকার হলে আবার import করুন।</p>
    </section>

    <div class="notice" id="undo-box" hidden>
        <div class="spread">
            <span id="undo-text"></span>
            <button class="btn btn-small" type="button" id="undo">আগের অবস্থায় ফিরুন</button>
        </div>
    </div>

    <div class="grid-2">
        <section class="card">
            <header>
                <h2>Export</h2>
                <p class="card-note" id="stats"></p>
            </header>
            <div class="row">
                <button class="btn btn-primary" type="button" data-export="all">পুরো ডেটা (JSON)</button>
                <button class="btn" type="button" data-export="projects">শুধু প্রজেক্ট</button>
                <button class="btn" type="button" data-export="catalog">শুধু ক্যাটালগ</button>
                <button class="btn" type="button" data-export="csv">প্রজেক্ট CSV</button>
            </div>
            <p class="small muted">প্রতিষ্ঠানে সবার একই তালিকা রাখতে চাইলে পুরো ডেটার JSON রিপোতে রাখুন, অথবা fork করা সাইটের <code>public/seed/</code> ফোল্ডারে দিন। নতুন কেউ খুললে সেটাই দেখবে।</p>
        </section>

        <section class="card">
            <header>
                <h2>সেটিংস</h2>
                <p class="card-note">কতদিন বাকি থাকলে জরুরি আর কতদিন বাকি থাকলে সতর্কতা দেখাবে, আর কোন কোন environment-এর নাম প্রস্তাব করবে।</p>
            </header>
            <form id="settings" class="stack">
                <div class="form-grid">
                    <label class="field"><span>জরুরি: যত দিনের মধ্যে</span><input type="number" name="redDays" min="0" max="3650"></label>
                    <label class="field"><span>সতর্কতা: যত দিনের মধ্যে</span><input type="number" name="yellowDays" min="0" max="3650"></label>
                </div>
                <label class="field"><span>Environment-এর নাম (কমা দিয়ে)</span><input type="text" name="deploymentNames"></label>
                <div><button class="btn" type="submit">সেটিংস সেভ করুন</button></div>
            </form>
        </section>
    </div>

    <section class="card">
        <header>
            <h2>Import</h2>
            <p class="card-note">এই টুল থেকে export করা JSON, AI-এর উত্তর, বা একই আকারের যেকোনো JSON। বসানোর আগে দেখাবে কী কী বদলাবে।</p>
        </header>
        <div class="grid-2">
            <div class="stack">
                <label class="dropzone" id="drop">
                    <input type="file" id="file" accept=".json,application/json" hidden>
                    <b>JSON ফাইল এখানে টেনে আনুন</b>
                    <span class="small">অথবা ক্লিক করে বাছুন</span>
                </label>
                <div class="row" style="flex-wrap: nowrap">
                    <input type="url" id="url" placeholder="অথবা JSON-এর লিংক, যেমন raw.githubusercontent.com/…" aria-label="JSON-এর লিংক">
                    <button class="btn" type="button" id="fetch-url">আনুন</button>
                </div>
            </div>
            <label class="field"><span>অথবা লেখা পেস্ট করুন</span><textarea id="paste" rows="7" placeholder='{ "projects": [ … ] }'></textarea></label>
        </div>
        <div class="row">
            <span class="small muted">কীভাবে বসাবে:</span>
            <label class="check"><input type="radio" name="mode" value="merge" checked>মিলিয়ে নেওয়া (একই id হালনাগাদ, বাকি সব থাকবে)</label>
            <label class="check"><input type="radio" name="mode" value="replace">বদলে দেওয়া (ফাইলে যে অংশ আছে, সেটা পুরো বদলাবে)</label>
        </div>
        <div><button class="btn" type="button" id="read-paste">পেস্ট করা লেখা যাচাই করুন</button></div>
        <p class="notice s-critical" id="import-error" hidden></p>
        <div class="notice" id="preview" hidden>
            <div class="stack">
                <b id="preview-title">যা বদলাবে</b>
                <div id="preview-body"></div>
                <div class="row">
                    <button class="btn btn-primary" type="button" id="apply">প্রয়োগ করুন</button>
                    <button class="btn" type="button" id="cancel">বাতিল</button>
                </div>
            </div>
        </div>
    </section>

    <section class="card">
        <header>
            <h2>ক্যাটালগ হালনাগাদ</h2>
            <p class="card-note">নতুন ভার্সন রিলিজ হলে বা তারিখ বদলালে ক্যাটালগ হালনাগাদ করুন। আপনার হাতে লেখা প্রোডাক্ট, নোট আর শর্ত থেকে যায়।</p>
        </header>
        <div class="row">
            <button class="btn" type="button" id="cat-eol">endoflife.date থেকে সব প্রোডাক্ট হালনাগাদ</button>
            <button class="btn" type="button" id="cat-seed">এই সাইটের সাথে আসা ক্যাটালগ থেকে নিন</button>
        </div>
        <p class="small muted" id="cat-progress"></p>
    </section>

    <section class="card">
        <header>
            <h2>নতুন করে শুরু</h2>
            <p class="card-note">এগুলো করার পরও একবার "আগের অবস্থায় ফিরুন" দিয়ে ফেরা যায়। তবু আগে export করে রাখা ভালো।</p>
        </header>
        <div class="row">
            <button class="btn" type="button" id="load-sample">নমুনা ডেটা দেখুন</button>
            <button class="btn btn-danger" type="button" id="clear-projects">সব প্রজেক্ট মুছুন</button>
            <button class="btn btn-danger" type="button" id="clear-all">সব কিছু মুছে শুরুর অবস্থায় ফিরুন</button>
        </div>
    </section>
</template>

<script>
    const P = PHD;
    const ui = P.ui;
    let pending = null;

    function renderStats() {
        const d = P.store.get();
        const versions = function (k) { return d.catalog[k].reduce(function (s, p) { return s + p.versions.length; }, 0); };
        ui.$('#stats').textContent = P.num(d.projects.length) + 'টি প্রজেক্ট, টেক ক্যাটালগে ' + P.num(d.catalog.tech.length) + 'টি প্রোডাক্ট (' + P.num(versions('tech')) + ' ভার্সন), এনভায়রনমেন্টে ' + P.num(d.catalog.env.length) + 'টি (' + P.num(versions('env')) + ' ভার্সন)।';
        const s = ui.$('#settings').elements;
        s.redDays.value = d.settings.redDays;
        s.yellowDays.value = d.settings.yellowDays;
        s.deploymentNames.value = d.settings.deploymentNames.join(', ');
        const u = P.store.undoInfo();
        ui.$('#undo-box').hidden = !u;
        if (u) ui.$('#undo-text').textContent = 'শেষ বড় বদল: ' + u.label + ' (' + new Date(u.at).toLocaleString('bn-BD') + ')।';
    }

    function mode() {
        return document.querySelector('input[name="mode"]:checked').value;
    }

    function showError(msg) {
        const e = ui.$('#import-error');
        e.textContent = msg || '';
        e.hidden = !msg;
        if (msg) ui.$('#preview').hidden = true;
    }

    // next: বসানোর পর পুরো ডেটা কেমন হবে
    function preview(next, label, title) {
        const current = P.store.get();
        const diff = ui.diffHtml(current, P.normalizeData(next));
        pending = { next: next, label: label };
        ui.$('#preview-title').textContent = title || 'যা বদলাবে';
        ui.$('#preview-body').innerHTML = diff.html;
        ui.$('#apply').disabled = diff.empty;
        ui.$('#preview').hidden = false;
        showError('');
        ui.$('#preview').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function readText(text, source) {
        try {
            const incoming = P.normalizeData(P.extractJson(text));
            const next = P.mergeData(P.store.get(), incoming, mode());
            const parts = [];
            if (incoming.has.projects) parts.push(P.num(incoming.projects.length) + 'টি প্রজেক্ট');
            if (incoming.has.tech) parts.push(P.num(incoming.catalog.tech.length) + 'টি টেক প্রোডাক্ট');
            if (incoming.has.env) parts.push(P.num(incoming.catalog.env.length) + 'টি এনভায়রনমেন্ট প্রোডাক্ট');
            if (incoming.has.settings) parts.push('সেটিংস');
            preview(next, 'import (' + source + ')', source + '-এ আছে ' + parts.join(', ') + '। ' + (mode() === 'merge' ? 'মিলিয়ে নিলে' : 'বদলে দিলে') + ':');
        } catch (err) {
            showError(ui.importError(err));
        }
    }

    function exportJson(which) {
        const d = P.store.get();
        const date = P.isoDate(P.today());
        if (which === 'csv') return ui.download('projects-' + date + '.csv', ui.rowsToCsv(P.analyze(d, { includeArchived: true }).rows), 'text/csv;charset=utf-8');
        let body = P.exportData(d);
        if (which === 'projects') body = { app: body.app, schemaVersion: body.schemaVersion, exportedAt: body.exportedAt, projects: body.projects };
        if (which === 'catalog') body = { app: body.app, schemaVersion: body.schemaVersion, exportedAt: body.exportedAt, catalog: body.catalog };
        ui.download('project-health-' + (which === 'all' ? 'backup' : which) + '-' + date + '.json', JSON.stringify(body, null, 2));
    }

    ui.$$('[data-export]').forEach(function (b) {
        b.addEventListener('click', function () { exportJson(b.dataset.export); });
    });

    ui.$('#settings').addEventListener('submit', function (e) {
        e.preventDefault();
        const el = e.target.elements;
        const s = P.normalizeSettings({ redDays: el.redDays.value, yellowDays: el.yellowDays.value, deploymentNames: el.deploymentNames.value });
        P.store.update(function (next) { next.settings = s; });
        ui.toast('সেটিংস সেভ হয়েছে।');
    });

    const drop = ui.$('#drop');
    function takeFile(file) {
        if (!file) return;
        ui.readFile(file).then(function (text) { readText(text, file.name); }).catch(function () { showError('ফাইল পড়া গেল না।'); });
    }
    ui.$('#file').addEventListener('change', function (e) { takeFile(e.target.files[0]); e.target.value = ''; });
    drop.addEventListener('dragover', function (e) { e.preventDefault(); drop.classList.add('over'); });
    drop.addEventListener('dragleave', function () { drop.classList.remove('over'); });
    drop.addEventListener('drop', function (e) {
        e.preventDefault();
        drop.classList.remove('over');
        takeFile(e.dataTransfer.files[0]);
    });
    ui.$('#read-paste').addEventListener('click', function () { readText(ui.$('#paste').value, 'পেস্ট করা লেখা'); });
    ui.$('#fetch-url').addEventListener('click', function () {
        const url = ui.$('#url').value.trim();
        if (!/^https:\/\//.test(url)) return showError('https:// দিয়ে শুরু হওয়া লিংক দিন।');
        fetch(url).then(function (r) {
            if (!r.ok) throw new Error('http-' + r.status);
            return r.text();
        }).then(function (text) { readText(text, 'লিংক'); }).catch(function (err) {
            showError('লিংক থেকে আনা গেল না (' + err.message + ')। লিংকটা সরাসরি JSON কিনা আর সবার জন্য খোলা কিনা দেখুন।');
        });
    });
    document.querySelectorAll('input[name="mode"]').forEach(function (r) {
        r.addEventListener('change', function () { ui.$('#preview').hidden = true; pending = null; });
    });

    ui.$('#apply').addEventListener('click', function () {
        if (!pending) return;
        P.store.apply(pending.next, pending.label);
        pending = null;
        ui.$('#preview').hidden = true;
        ui.$('#paste').value = '';
        ui.undoToast('ডেটা বসানো হয়েছে।');
    });
    ui.$('#cancel').addEventListener('click', function () {
        pending = null;
        ui.$('#preview').hidden = true;
    });
    ui.$('#undo').addEventListener('click', function () {
        if (P.store.undo()) ui.toast('আগের অবস্থায় ফেরানো হয়েছে।');
    });

    ui.$('#cat-seed').addEventListener('click', function () {
        P.store.seed().then(function (seed) {
            const incoming = P.normalizeData({ catalog: seed.catalog });
            preview(P.mergeData(P.store.get(), incoming, 'merge'), 'সাইটের ক্যাটালগ থেকে হালনাগাদ', 'সাইটের সাথে আসা ক্যাটালগ মিলিয়ে নিলে:');
        }).catch(function () { showError('সাইটের ক্যাটালগ ফাইল পাওয়া গেল না।'); });
    });

    ui.$('#cat-eol').addEventListener('click', async function (e) {
        const btn = e.currentTarget;
        const d = P.store.get();
        const jobs = [];
        P.KINDS.forEach(function (k) {
            d.catalog[k].forEach(function (p) { if (p.eolSlug) jobs.push({ kind: k, product: p }); });
        });
        if (!jobs.length) return showError('কোনো প্রোডাক্টে endoflife.date-এর নাম দেওয়া নেই।');
        btn.disabled = true;
        const fresh = { tech: [], env: [] };
        const failed = [];
        for (let i = 0; i < jobs.length; i++) {
            const j = jobs[i];
            ui.$('#cat-progress').textContent = 'আনা হচ্ছে ' + P.num(i + 1) + '/' + P.num(jobs.length) + ': ' + j.product.name;
            try {
                fresh[j.kind].push(P.productFromEndOfLife(await P.fetchEndOfLife(j.product.eolSlug), j.kind, { id: j.product.id }));
            } catch (err) {
                failed.push(j.product.name);
            }
        }
        btn.disabled = false;
        ui.$('#cat-progress').textContent = failed.length ? 'আনা যায়নি: ' + failed.join(', ') : 'সব প্রোডাক্ট আনা হয়েছে।';
        const incoming = P.normalizeData({ catalog: fresh });
        preview(P.mergeData(P.store.get(), incoming, 'merge'), 'endoflife.date থেকে হালনাগাদ', 'endoflife.date-এর তারিখ মিলিয়ে নিলে:');
    });

    ui.$('#load-sample').addEventListener('click', function () {
        if (!confirm('এখনকার প্রজেক্টগুলোর বদলে নমুনা প্রজেক্ট বসবে। আগের অবস্থায় ফেরা যাবে।')) return;
        P.store.seed().then(function (seed) {
            const next = P.clone(P.store.get());
            next.projects = seed.projects;
            next.meta.sample = true;
            P.store.apply(next, 'নমুনা ডেটা বসানো');
            ui.undoToast('নমুনা ডেটা বসানো হয়েছে।');
        });
    });
    ui.$('#clear-projects').addEventListener('click', function () {
        if (!confirm('সব প্রজেক্ট মুছে যাবে। ক্যাটালগ আর সেটিংস থাকবে।')) return;
        const next = P.clone(P.store.get());
        next.projects = [];
        next.meta.sample = false;
        P.store.apply(next, 'সব প্রজেক্ট মুছে ফেলা');
        ui.undoToast('সব প্রজেক্ট মুছে ফেলা হয়েছে।');
    });
    ui.$('#clear-all').addEventListener('click', function () {
        if (!confirm('প্রজেক্ট, ক্যাটালগ আর সেটিংস সব মুছে সাইটের শুরুর ক্যাটালগে ফিরবে, কোনো প্রজেক্ট থাকবে না।')) return;
        P.store.seed().then(function (seed) {
            const next = P.emptyData();
            next.catalog = seed.catalog;
            P.store.apply(next, 'সব কিছু মুছে ফেলা');
            ui.undoToast('সব কিছু মুছে শুরুর অবস্থায় ফেরা হয়েছে।');
        });
    });

    P.store.ready().then(renderStats);
    ui.onChange(renderStats);
</script>
