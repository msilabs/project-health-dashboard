<head>
    <title>ক্যাটালগ | {{ data.site.name }}</title>
</head>

<template>
    <div class="page-head">
        <div>
            <h1>ক্যাটালগ</h1>
            <p>প্রতিটা প্রোডাক্টের ভার্সন আর তাদের সাপোর্ট কবে পর্যন্ত। তারিখ আসে <a href="https://endoflife.date" target="_blank" rel="noopener">endoflife.date</a> থেকে, হাতেও বদলানো যায়।</p>
        </div>
        <div class="actions">
            <button class="btn" type="button" id="refresh"><Icon name="refresh" /><span>endoflife.date থেকে হালনাগাদ</span></button>
            <button class="btn btn-primary" type="button" id="new"><Icon name="plus" />নতুন প্রোডাক্ট</button>
        </div>
    </div>

    <div class="notice" id="refresh-preview" hidden>
        <div class="spread">
            <div class="stack stack-sm">
                <b>endoflife.date-এর তারিখ মিলিয়ে নিলে</b>
                <div id="refresh-body"></div>
            </div>
            <div class="row">
                <button class="btn btn-sm" type="button" id="refresh-cancel">বাতিল</button>
                <button class="btn btn-primary btn-sm" type="button" id="refresh-apply">প্রয়োগ করুন</button>
            </div>
        </div>
    </div>

    <section class="card">
        <div class="toolbar">
            <div class="segmented" id="kind" role="tablist" aria-label="ক্যাটালগ"></div>
            <label class="search"><Icon name="search" /><input type="search" id="q" placeholder="প্রোডাক্ট বা ভার্সন" aria-label="খুঁজুন"></label>
            <span class="spacer"></span>
            <select id="category" aria-label="ধরন"></select>
            <label class="check"><input type="checkbox" id="used">শুধু ব্যবহৃত</label>
        </div>
        <div class="skeleton" id="skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <div id="list"></div>
    </section>

    <dialog class="modal wide" id="editor" aria-labelledby="ed-title">
        <form class="sheet" novalidate>
            <div class="sheet-head">
                <h2 id="ed-title">প্রোডাক্ট</h2>
                <button class="btn btn-ghost btn-sm btn-icon" type="button" data-close aria-label="বন্ধ করুন"><Icon name="x" /></button>
            </div>
            <div class="sheet-body">
                <div class="form-grid">
                    <label class="field"><span>নাম *</span><input type="text" name="name" maxlength="60"></label>
                    <label class="field"><span>ধরন</span><select name="category"></select></label>
                    <label class="field"><span>endoflife.date-এর নাম</span><input type="text" name="eolSlug" placeholder="যেমন php, laravel"><small>endoflife.date/<b>php</b> লিংকের শেষ অংশ</small></label>
                </div>
                <div><button class="btn btn-sm" type="button" id="fetch"><Icon name="refresh" />endoflife.date থেকে তারিখ আনুন</button></div>
                <div class="section">
                    <div class="section-title"><span>ভার্সন</span><button class="btn btn-ghost btn-sm" type="button" id="add-version"><Icon name="plus" />ভার্সন</button></div>
                    <div class="tablewrap bordered">
                        <table class="table ver-edit">
                            <thead>
                                <tr><th>ভার্সন</th><th>সক্রিয় সাপোর্ট পর্যন্ত</th><th>সিকিউরিটি সাপোর্ট পর্যন্ত</th><th></th></tr>
                            </thead>
                            <tbody id="versions"></tbody>
                        </table>
                    </div>
                    <p class="small muted">সাইকেল লিখুন, যেমন 8.3 বা 12। "সক্রিয় সাপোর্ট" মানে বাগ ফিক্স আর নতুন ফিচার, "সিকিউরিটি সাপোর্ট" মানে শুধু নিরাপত্তা আপডেট। রিলিজের তারিখ, LTS আর কী লাগে "আরও" খুলে লিখুন।</p>
                </div>
                <p class="notice s-eol" id="ed-error" hidden></p>
            </div>
            <div class="sheet-foot">
                <button class="btn btn-ghost btn-sm btn-danger" type="button" id="delete"><Icon name="x" />প্রোডাক্ট মুছুন</button>
                <span class="row">
                    <button class="btn" type="button" data-close>বাতিল</button>
                    <button class="btn btn-primary" type="submit">সেভ করুন</button>
                </span>
            </div>
        </form>
    </dialog>
</template>

<script>
    const P = PHD;
    const ui = P.ui;
    const esc = P.esc;
    const query = ui.query();
    // used: null মানে এখনো ঠিক হয়নি; কোনো প্রজেক্টে কিছু ব্যবহার হলে শুরুতে শুধু সেগুলোই দেখায়
    const f = { kind: query.get('kind') === 'env' ? 'env' : 'tech', q: query.get('q') || '', category: '', used: query.get('q') ? false : null };
    const dialog = ui.$('#editor');
    const form = dialog.querySelector('form');
    const openOld = {};
    let editing = null;
    let pendingRefresh = null;

    function categories(data, kind) {
        const map = Object.assign({}, P.CATEGORIES[kind]);
        data.catalog[kind].forEach(function (p) { if (!map[p.category]) map[p.category] = p.category; });
        return map;
    }

    function projectsLink(product, version, n) {
        if (!n) return '<span class="muted">—</span>';
        return '<a href="' + esc(P.url('/projects/?product=' + encodeURIComponent(f.kind + '|' + product) + (version ? '&version=' + encodeURIComponent(version) : ''))) + '">' + P.num(n) + 'টি প্রজেক্ট</a>';
    }

    function dateCell(d, fallback) {
        return d ? '<span class="num">' + P.fmtDate(d) + '</span>' : '<span class="muted">' + esc(fallback || '—') + '</span>';
    }

    function render() {
        const data = P.store.get();
        ui.$('#kind').innerHTML = P.KINDS.map(function (k) {
            return '<button type="button" role="tab" data-kind="' + k + '" aria-pressed="' + (f.kind === k) + '">' + P.KIND_LABEL[k] + ' <span class="count">' + P.num(data.catalog[k].length) + '</span></button>';
        }).join('');
        const cats = categories(data, f.kind);
        ui.$('#category').innerHTML = ui.options(cats, f.category, 'সব ধরন');
        ui.$('#category').value = f.category;
        ui.setQuery({ kind: f.kind === 'tech' ? '' : f.kind, q: f.q.trim() });

        const usage = P.usage(P.analyze(data, { includeArchived: true }).rows);
        if (f.used === null) f.used = Object.keys(usage).length > 0;
        ui.$('#used').checked = f.used;
        ui.$('#skeleton').hidden = true;
        const needle = f.q.trim().toLowerCase();
        const html = data.catalog[f.kind].map(function (product) {
            if (f.category && product.category !== f.category) return '';
            if (needle && (product.name + ' ' + product.id + ' ' + product.versions.map(function (v) { return v.version; }).join(' ')).toLowerCase().indexOf(needle) === -1) return '';
            const rows = product.versions.map(function (v) {
                return { v: v, s: P.cycleStatus(v, data.settings), n: P.usageCount(usage, f.kind, product.id, v.version) };
            });
            const used = rows.filter(function (r) { return r.n; });
            if (f.used && !used.length) return '';
            const projectIds = {};
            Object.keys(usage).forEach(function (k) {
                if (k.indexOf(f.kind + '|' + product.id + '|') === 0) usage[k].projects.forEach(function (p) { projectIds[p.id] = true; });
            });
            let worst = null;
            used.forEach(function (r) { if (!worst || P.statusRank(r.s.status) > P.statusRank(worst)) worst = r.s.status; });
            const showOld = openOld[product.id];
            const visible = rows.filter(function (r) { return showOld || r.n || r.s.status !== 'eol'; });
            const hidden = rows.length - visible.length;
            const table = visible.length
                ? '<div class="tablewrap"><table class="table"><thead><tr><th>ভার্সন</th><th>সক্রিয় সাপোর্ট</th><th>সিকিউরিটি সাপোর্ট</th><th>অবস্থা</th><th>ব্যবহার</th></tr></thead><tbody>' +
                  visible.map(function (r) {
                      const v = r.v;
                      const extra = [v.lts ? 'LTS' : '', v.released ? 'রিলিজ ' + P.fmtDate(v.released) : '', v.requires.length ? 'লাগে ' + P.formatRequires(v.requires) : ''].filter(Boolean).join(' · ');
                      return '<tr><td><b>' + esc(v.version) + '</b>' + (extra ? '<br><span class="small muted">' + esc(extra) + '</span>' : '') + '</td>' +
                          '<td>' + dateCell(v.supportUntil) + '</td>' +
                          '<td>' + dateCell(v.securityUntil, v.state ? P.VERSION_STATES[v.state] : '') + '</td>' +
                          '<td>' + ui.badge(r.s.status, r.s.status === 'ok' && r.s.phase === 'security' ? 'শুধু সিকিউরিটি' : null) + '</td>' +
                          '<td class="small">' + projectsLink(product.id, v.version, r.n) + '</td></tr>';
                  }).join('') + '</tbody></table></div>'
                : '<p class="small muted">সক্রিয় কোনো ভার্সন নেই।</p>';
            return (
                '<details class="product"' + (used.length ? ' open' : '') + '>' +
                '<summary>' + ui.icon('chevron').replace('class="icon"', 'class="icon chev"') + ui.avatar(product.name) +
                '<span><b>' + esc(product.name) + '</b> <span class="small muted">' + esc(cats[product.category] || product.category) + '</span></span>' +
                '<span class="small hide-sm">' + projectsLink(product.id, '', Object.keys(projectIds).length) + '</span>' +
                (worst ? ui.badge(worst) : '<span class="small muted">' + P.num(product.versions.length) + 'টি ভার্সন</span>') +
                '</summary>' +
                '<div class="product-body stack stack-sm">' + table +
                '<div class="spread small"><span class="row">' +
                (hidden || showOld ? '<button class="link-btn" type="button" data-old="' + esc(product.id) + '">' + (showOld ? 'পুরনো ভার্সন লুকান' : 'শেষ হওয়া আরও ' + P.num(hidden) + 'টি ভার্সন দেখান') + '</button>' : '') +
                (product.eolSlug ? '<a href="https://endoflife.date/' + esc(product.eolSlug) + '" target="_blank" rel="noopener">endoflife.date/' + esc(product.eolSlug) + '</a>' : '') +
                '</span><button class="btn btn-sm" type="button" data-edit="' + esc(product.id) + '">' + ui.icon('edit') + 'এডিট</button></div>' +
                '</div></details>'
            );
        }).join('');
        ui.$('#list').innerHTML = html || '<div class="empty"><p>' + (f.used && !needle && !f.category ? 'এই ট্যাবের কোনো প্রোডাক্ট এখনো কোনো প্রজেক্টে নেই। সব দেখতে "শুধু ব্যবহৃত" থেকে টিক তুলে দিন।' : 'এই ফিল্টারে কোনো প্রোডাক্ট নেই।') + '</p></div>';
    }

    /* ---------- এডিটর ---------- */

    function versionRows(v) {
        v = v || { version: '', released: '', supportUntil: '', securityUntil: '', lts: false, state: '', requires: [] };
        return (
            '<tr data-row>' +
            '<td><input type="text" data-k="version" value="' + esc(v.version) + '" placeholder="8.3"></td>' +
            '<td><input type="date" data-k="supportUntil" value="' + esc(v.supportUntil) + '"></td>' +
            '<td><input type="date" data-k="securityUntil" value="' + esc(v.securityUntil) + '"></td>' +
            '<td class="num"><button class="btn btn-ghost btn-sm" type="button" data-more>আরও</button><button class="btn btn-ghost btn-sm btn-icon" type="button" data-remove aria-label="ভার্সন সরান">' + ui.icon('x') + '</button></td>' +
            '</tr>' +
            '<tr class="more" data-more-row hidden><td colspan="4"><div class="form-grid">' +
            '<label class="field"><span>রিলিজ</span><input type="date" data-k="released" value="' + esc(v.released) + '"></label>' +
            '<label class="field"><span>তারিখ না থাকলে</span><select data-k="state">' + ui.options(P.VERSION_STATES, v.state) + '</select></label>' +
            '<label class="field"><span>যা লাগে</span><input type="text" data-k="requires" value="' + esc(P.formatRequires(v.requires)) + '" placeholder="php 8.2-8.5, nodejs 20+"></label>' +
            '<label class="check"><input type="checkbox" data-k="lts"' + (v.lts ? ' checked' : '') + '>LTS</label>' +
            '</div></td></tr>'
        );
    }

    function fillVersions(versions) {
        ui.$('#versions').innerHTML = (versions.length ? versions : [null]).map(versionRows).join('');
    }

    function collect() {
        const el = form.elements;
        return {
            id: editing || P.slug(el.name.value),
            name: el.name.value.trim(),
            category: el.category.value,
            eolSlug: el.eolSlug.value.trim(),
            versions: ui.$$('[data-row]', dialog).map(function (tr) {
                const more = tr.nextElementSibling;
                const get = function (k) { return tr.querySelector('[data-k="' + k + '"]') || more.querySelector('[data-k="' + k + '"]'); };
                return {
                    version: get('version').value.trim(),
                    released: get('released').value,
                    supportUntil: get('supportUntil').value,
                    securityUntil: get('securityUntil').value,
                    state: get('state').value,
                    lts: get('lts').checked,
                    requires: get('requires').value
                };
            }).filter(function (v) { return v.version; })
        };
    }

    function error(msg) {
        const e = ui.$('#ed-error');
        e.textContent = msg || '';
        e.hidden = !msg;
    }

    function openEditor(product, name) {
        editing = product ? product.id : null;
        const p = product || { id: '', name: name || '', category: Object.keys(P.CATEGORIES[f.kind])[0], eolSlug: '', versions: [] };
        ui.$('#ed-title').textContent = editing ? p.name : 'নতুন প্রোডাক্ট · ' + P.KIND_LABEL[f.kind];
        form.elements.name.value = p.name;
        form.elements.category.innerHTML = ui.options(categories(P.store.get(), f.kind), p.category);
        form.elements.eolSlug.value = p.eolSlug || (name ? P.slug(name) : '');
        fillVersions(p.versions);
        ui.$('#delete').hidden = !editing;
        error('');
        dialog.showModal();
        form.elements.name.focus();
    }

    ui.bindDialog(dialog, function () {
        editing = null;
        const q = new URLSearchParams(location.search);
        q.delete('edit');
        q.delete('new');
        q.delete('name');
        history.replaceState(null, '', location.pathname + (q.toString() ? '?' + q : ''));
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        const input = collect();
        if (!input.name) return error('প্রোডাক্টের নাম লিখুন।');
        if (!input.id) return error('নামে অন্তত একটা অক্ষর বা সংখ্যা রাখুন।');
        const seen = {};
        for (const v of input.versions) {
            if (seen[v.version]) return error('ভার্সন ' + v.version + ' দুবার আছে।');
            seen[v.version] = true;
            if (v.supportUntil && v.securityUntil && v.securityUntil < v.supportUntil) return error(v.version + ': সিকিউরিটি সাপোর্টের তারিখ সক্রিয় সাপোর্টের আগে হতে পারে না।');
        }
        if (!editing && P.findProduct(P.store.get(), f.kind, input.id)) return error('"' + input.name + '" নামের প্রোডাক্ট আগেই আছে।');
        const product = P.normalizeProduct(Object.assign(input, { id: editing || input.id }), f.kind);
        P.store.update(function (next) {
            const list = next.catalog[f.kind];
            const i = list.findIndex(function (p) { return p.id === product.id; });
            if (i === -1) list.push(product);
            else list[i] = product;
        });
        dialog.close();
        ui.toast('"' + product.name + '" সেভ হয়েছে।');
    });

    dialog.addEventListener('click', function (e) {
        const t = e.target.closest('button');
        if (!t) return;
        if (t.hasAttribute('data-remove')) {
            const tr = t.closest('tr');
            tr.nextElementSibling.remove();
            tr.remove();
        } else if (t.hasAttribute('data-more')) {
            const more = t.closest('tr').nextElementSibling;
            more.hidden = !more.hidden;
        }
    });

    ui.$('#add-version').addEventListener('click', function () {
        ui.$('#versions').insertAdjacentHTML('afterbegin', versionRows());
        ui.$('#versions [data-k="version"]').focus();
    });

    ui.$('#fetch').addEventListener('click', function (e) {
        const btn = e.currentTarget;
        const slug = form.elements.eolSlug.value.trim() || P.slug(form.elements.name.value);
        if (!slug) return error('endoflife.date-এর নাম লিখুন।');
        btn.disabled = true;
        error('');
        P.fetchEndOfLife(slug).then(function (result) {
            const id = editing || P.slug(form.elements.name.value || slug);
            const current = P.normalizeProduct(Object.assign(collect(), { id: id }), f.kind);
            const fresh = P.productFromEndOfLife(result, f.kind, { id: id });
            const merged = current ? P.mergeProduct(current, fresh) : fresh;
            const added = merged.versions.length - (current ? current.versions.length : 0);
            if (!form.elements.name.value.trim()) form.elements.name.value = fresh.name;
            form.elements.eolSlug.value = slug;
            fillVersions(merged.versions);
            ui.toast(P.num(fresh.versions.length) + 'টি ভার্সনের তারিখ এসেছে, নতুন ' + P.num(added) + 'টি। দেখে নিয়ে সেভ করুন।');
        }).catch(function (err) {
            error(err.message === 'not-found' ? 'endoflife.date-এ "' + slug + '" নামে কিছু নেই। তারিখ হাতে লিখুন।' : 'আনা গেল না। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।');
        }).finally(function () { btn.disabled = false; });
    });

    ui.$('#delete').addEventListener('click', function () {
        const data = P.store.get();
        const product = P.findProduct(data, f.kind, editing);
        if (!product) return;
        const usedBy = data.projects.filter(function (p) {
            const refs = f.kind === 'tech' ? p.tech : p.deployments.reduce(function (a, d) { return a.concat(d.stack); }, []);
            return refs.some(function (r) { return r.product === product.id; });
        }).length;
        const kind = f.kind;
        // ব্যবহার না থাকলে সরাসরি মোছে; ফিরিয়ে আনার বোতাম টোস্টে থাকে
        const ask = usedBy ? ui.confirm('"' + product.name + '" ' + P.num(usedBy) + 'টি প্রজেক্টে আছে। মুছলে সেখানে "ক্যাটালগে নেই" দেখাবে।', 'তবু মুছুন') : Promise.resolve(true);
        ask.then(function (yes) {
            if (!yes) return;
            const next = P.clone(P.store.get());
            next.catalog[kind] = next.catalog[kind].filter(function (p) { return p.id !== product.id; });
            P.store.apply(next, 'প্রোডাক্ট মুছে ফেলা');
            dialog.close();
            ui.undoToast('"' + product.name + '" মুছে ফেলা হয়েছে।');
        });
    });

    /* ---------- সব প্রোডাক্ট হালনাগাদ ---------- */

    ui.$('#refresh').addEventListener('click', async function (e) {
        const btn = e.currentTarget;
        const label = btn.querySelector('span');
        const data = P.store.get();
        const jobs = [];
        P.KINDS.forEach(function (k) { data.catalog[k].forEach(function (p) { if (p.eolSlug) jobs.push({ kind: k, product: p }); }); });
        if (!jobs.length) return ui.toast('কোনো প্রোডাক্টে endoflife.date-এর নাম নেই।', 'warning');
        btn.disabled = true;
        const fresh = { tech: [], env: [] };
        const failed = [];
        for (let i = 0; i < jobs.length; i++) {
            label.textContent = 'আনা হচ্ছে ' + P.num(i + 1) + '/' + P.num(jobs.length);
            try {
                fresh[jobs[i].kind].push(P.productFromEndOfLife(await P.fetchEndOfLife(jobs[i].product.eolSlug), jobs[i].kind, { id: jobs[i].product.id }));
            } catch (err) {
                failed.push(jobs[i].product.name);
            }
        }
        btn.disabled = false;
        label.textContent = 'endoflife.date থেকে হালনাগাদ';
        pendingRefresh = P.mergeData(P.store.get(), P.normalizeData({ catalog: fresh }), 'merge');
        const diff = ui.diffHtml(P.store.get(), P.normalizeData(pendingRefresh));
        ui.$('#refresh-body').innerHTML = diff.html + (failed.length ? '<p class="small muted">আনা যায়নি: ' + esc(failed.join(', ')) + '</p>' : '');
        ui.$('#refresh-apply').disabled = diff.empty;
        ui.$('#refresh-preview').hidden = false;
    });
    ui.$('#refresh-apply').addEventListener('click', function () {
        if (!pendingRefresh) return;
        P.store.apply(pendingRefresh, 'ক্যাটালগ হালনাগাদ');
        pendingRefresh = null;
        ui.$('#refresh-preview').hidden = true;
        ui.undoToast('ক্যাটালগ হালনাগাদ হয়েছে।');
    });
    ui.$('#refresh-cancel').addEventListener('click', function () {
        pendingRefresh = null;
        ui.$('#refresh-preview').hidden = true;
    });

    /* ---------- তালিকার ঘটনা ---------- */

    ui.$('#kind').addEventListener('click', function (e) {
        const b = e.target.closest('[data-kind]');
        if (!b) return;
        f.kind = b.dataset.kind;
        f.category = '';
        render();
    });
    ui.$('#list').addEventListener('click', function (e) {
        const edit = e.target.closest('[data-edit]');
        if (edit) return openEditor(P.findProduct(P.store.get(), f.kind, edit.dataset.edit));
        const old = e.target.closest('[data-old]');
        if (old) {
            openOld[old.dataset.old] = !openOld[old.dataset.old];
            render();
        }
    });
    ui.$('#new').addEventListener('click', function () { openEditor(null); });
    ui.$('#category').addEventListener('change', function (e) { f.category = e.target.value; render(); });
    ui.$('#used').addEventListener('change', function (e) { f.used = e.target.checked; render(); });
    let typing;
    ui.$('#q').addEventListener('input', function (e) {
        clearTimeout(typing);
        typing = setTimeout(function () { f.q = e.target.value; render(); }, 150);
    });

    P.store.ready().then(function () {
        ui.$('#q').value = f.q;
        render();
        const product = query.get('edit') && P.findProduct(P.store.get(), f.kind, query.get('edit'));
        if (product) openEditor(product);
        else if (query.get('new')) openEditor(null, query.get('name') || '');
    });
    ui.onChange(function () { if (!dialog.open) render(); });
</script>
