<head>
    <title>বিশ্লেষণ | {{ data.site.name }}</title>
</head>

<template>
    <section class="intro">
        <h1>বিশ্লেষণ</h1>
        <p>কোন ভার্সন কোথায় চলছে, কবে সাপোর্ট শেষ, কোথায় সার্ভারের সাথে টেকের মিল নেই, আর কোন তথ্য এখনো জানা নেই।</p>
    </section>

    <section class="card">
        <div class="filters">
            <label class="field"><span>Environment</span><select id="f-dep"></select></label>
            <label class="field"><span>ধরন</span><select id="f-kind"></select></label>
            <label class="check"><input type="checkbox" id="f-archived">আর্কাইভ করা প্রজেক্টও ধরুন</label>
        </div>
        <p class="small muted" id="scope"></p>
    </section>

    <div class="empty" id="empty" hidden>
        <p>বিশ্লেষণের জন্য আগে প্রজেক্ট যোগ করুন।</p>
        <a class="btn btn-primary" href="/projects/?new=1">প্রজেক্ট যোগ করুন</a>
    </div>

    <div class="stack" id="content" style="gap: 1.5rem">
        <section class="card">
            <header>
                <h2>সাপোর্ট টাইমলাইন</h2>
                <p class="card-note">আপনার প্রজেক্টে চলা প্রতিটা ভার্সন কবে রিলিজ হয়েছে, সক্রিয় সাপোর্ট কবে শেষ, আর সিকিউরিটি সাপোর্ট কবে শেষ। রং দেখায় আজকের অবস্থা; ডানে কয়টা প্রজেক্টে চলছে।</p>
            </header>
            <ul class="legend" id="legend"></ul>
            <div class="chart" id="timeline"></div>
        </section>

        <section class="card">
            <header>
                <h2>ভার্সন বণ্টন</h2>
                <p class="card-note">প্রতিটা প্রোডাক্টের কোন ভার্সন কয়টা প্রজেক্টে। একই প্রোডাক্টে অনেক ভার্সন মানে আপগ্রেডের কাজ ছড়িয়ে আছে।</p>
            </header>
            <div id="dist"></div>
        </section>

        <section class="card" id="issues">
            <header>
                <h2>সামঞ্জস্য আর অমিল</h2>
                <p class="card-note">ক্যাটালগে কোনো টেক ভার্সনের জন্য যে রানটাইম বা প্যাকেজের ভার্সন লেখা আছে, তা না মিললে সামঞ্জস্যের সমস্যা। একই প্রজেক্টের বিভিন্ন environment-এ একই প্রোডাক্টের ভিন্ন ভার্সন থাকলে অমিল।</p>
            </header>
            <ul class="list" id="issue-list"></ul>
        </section>

        <section class="card">
            <header>
                <h2>সাপোর্ট শেষ বা শেষ হওয়ার পথে</h2>
                <p class="card-note">যে ভার্সনের সাপোর্ট শেষ হয়ে গেছে বা সতর্কতার সীমার মধ্যে শেষ হবে, তারিখ অনুযায়ী।</p>
            </header>
            <div class="tablewrap">
                <table class="table">
                    <thead>
                        <tr><th>ভার্সন</th><th>অবস্থা</th><th>সাপোর্ট শেষ</th><th>ধাপ</th><th>প্রজেক্ট</th></tr>
                    </thead>
                    <tbody id="upcoming"></tbody>
                </table>
            </div>
        </section>

        <section class="card">
            <header>
                <h2>তথ্যের ঘাটতি</h2>
                <p class="card-note">এই অংশগুলোর অবস্থা হিসাব করা যায়নি। ক্যাটালগে প্রোডাক্ট বা তারিখ যোগ করলে, বা প্রজেক্টে ভার্সন লিখলে ঠিক হবে।</p>
            </header>
            <ul class="list" id="gaps"></ul>
        </section>
    </div>
</template>

<script>
    const P = PHD;
    const ui = P.ui;
    const esc = P.esc;
    const f = { dep: ui.query().get('dep') || '', kind: ui.query().get('kind') || '', archived: ui.query().get('archived') === '1' };

    function scoped(data) {
        const a = P.analyze(data, { includeArchived: f.archived, deployment: f.dep || undefined });
        const rows = a.rows
            .filter(function (r) { return !f.dep || r.project.deployments.some(function (d) { return d.name === f.dep; }); })
            .map(function (r) {
                if (!f.kind) return r;
                return Object.assign({}, r, { items: r.items.filter(function (x) { return x.kind === f.kind; }), issues: r.issues });
            });
        return { rows: rows, issues: [].concat.apply([], rows.map(function (r) { return r.issues; })) };
    }

    function renderFilters(data) {
        const deps = {};
        data.settings.deploymentNames.forEach(function (n) { deps[n] = n; });
        data.projects.forEach(function (p) { p.deployments.forEach(function (d) { deps[d.name] = d.name; }); });
        ui.$('#f-dep').innerHTML = ui.options(deps, f.dep, 'সব environment');
        ui.$('#f-kind').innerHTML = ui.options(P.KIND_LABEL, f.kind, 'টেক আর এনভায়রনমেন্ট');
        ui.$('#f-archived').checked = f.archived;
    }

    /* ---------- টাইমলাইন ---------- */

    function timeline(usage) {
        const el = ui.$('#timeline');
        const list = Object.keys(usage).map(function (k) { return usage[k]; }).filter(function (u) { return u.cycle.released || u.end; });
        if (!list.length) {
            el.innerHTML = '<p class="small muted">তারিখসহ কোনো ভার্সন নেই।</p>';
            return;
        }
        list.sort(function (a, b) {
            return P.KINDS.indexOf(a.kind) - P.KINDS.indexOf(b.kind) || a.productName.localeCompare(b.productName) || P.compareVersions(b.version, a.version);
        });
        const today = P.today();
        const year = function (t) { return new Date(t).getUTCFullYear(); };
        let minT = today;
        let maxT = today;
        list.forEach(function (u) {
            const r = P.parseDate(u.cycle.released);
            const e = P.parseDate(u.end);
            if (r !== null) minT = Math.min(minT, r);
            if (e !== null) maxT = Math.max(maxT, e);
        });
        const y0 = Math.max(year(minT), year(today) - 8);
        const y1 = Math.min(year(maxT) + 1, year(today) + 8);
        const d0 = Date.UTC(y0, 0, 1);
        const d1 = Date.UTC(y1, 0, 1);
        const W = Math.max(640, el.clientWidth || 900);
        const L = 150;
        const R = 92;
        const rowH = 24;
        const top = 28;
        const x = function (t) { return L + ((Math.min(Math.max(t, d0), d1) - d0) / (d1 - d0)) * (W - L - R); };
        let y = top;
        let prev = null;
        const ys = list.map(function (u) {
            const g = u.kind + u.product;
            if (prev !== null && prev !== g) y += 8;
            prev = g;
            const v = y;
            y += rowH;
            return v;
        });
        const H = y + 6;
        const span = y1 - y0;
        const step = span > 12 ? 3 : span > 7 ? 2 : 1;
        const out = ['<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="ভার্সনের সাপোর্ট টাইমলাইন">'];
        for (let yr = y0; yr <= y1; yr += step) {
            const gx = x(Date.UTC(yr, 0, 1));
            out.push('<line class="grid" x1="' + gx + '" x2="' + gx + '" y1="' + (top - 6) + '" y2="' + (H - 2) + '"></line>');
            out.push('<text class="tick" x="' + gx + '" y="14" text-anchor="middle">' + P.num(yr).replace(/,/g, '') + '</text>');
        }
        list.forEach(function (u, i) {
            const yy = ys[i];
            const by = yy + (rowH - 10) / 2;
            const rel = P.parseDate(u.cycle.released);
            const end = P.parseDate(u.end);
            const sup = P.parseDate(u.cycle.supportUntil);
            const x0 = x(rel !== null ? rel : d0);
            const xe = end !== null ? x(end) : x(d1);
            const xa = sup !== null ? x(sup) : xe;
            const color = 'var(--' + u.status + ')';
            const tip = u.productName + ' ' + u.version + '\n' +
                (u.cycle.released ? 'রিলিজ: ' + P.fmtDate(u.cycle.released) + '\n' : '') +
                (u.cycle.supportUntil ? 'সক্রিয় সাপোর্ট: ' + P.fmtDate(u.cycle.supportUntil) + ' পর্যন্ত\n' : '') +
                (u.end ? 'সাপোর্ট শেষ: ' + P.fmtDate(u.end) : 'শেষের তারিখ ঘোষিত নয়') + '\n' +
                P.STATUS[u.status].label + ' · ' + P.num(u.projects.length) + 'টি প্রজেক্ট';
            out.push('<g><title>' + esc(tip) + '</title>');
            out.push('<rect x="0" y="' + yy + '" width="' + W + '" height="' + rowH + '" fill="transparent"></rect>');
            out.push('<text x="' + (L - 10) + '" y="' + (yy + rowH / 2 + 4) + '" text-anchor="end">' + esc(u.productName + ' ' + u.version) + '</text>');
            out.push('<rect x="' + x0 + '" y="' + by + '" width="' + Math.max(2, xe - x0) + '" height="10" rx="4" fill="' + color + '" opacity="0.32"></rect>');
            if (xa > x0) out.push('<rect x="' + x0 + '" y="' + by + '" width="' + Math.max(2, xa - x0) + '" height="10" rx="4" fill="' + color + '"></rect>');
            if (end === null) out.push('<text class="tick" x="' + (x(d1) - 4) + '" y="' + (yy + rowH / 2 + 4) + '" text-anchor="end">→ চলছে</text>');
            out.push('<text class="tick" x="' + (W - R + 10) + '" y="' + (yy + rowH / 2 + 4) + '">' + P.num(u.projects.length) + 'টি প্রজেক্ট</text>');
            out.push('</g>');
        });
        const tx = x(today);
        out.push('<line class="today" x1="' + tx + '" x2="' + tx + '" y1="' + (top - 8) + '" y2="' + (H - 2) + '"></line>');
        out.push('<text x="' + tx + '" y="' + (top - 10) + '" text-anchor="middle" style="font-weight: 650">আজ</text>');
        out.push('</svg>');
        el.innerHTML = out.join('');
    }

    /* ---------- বণ্টন ---------- */

    function distribution(usage) {
        const byProduct = {};
        Object.keys(usage).forEach(function (k) {
            const u = usage[k];
            const key = u.kind + '|' + u.product;
            (byProduct[key] = byProduct[key] || { name: u.productName, kind: u.kind, product: u.product, items: [] }).items.push(u);
        });
        const groups = Object.keys(byProduct).map(function (k) { return byProduct[k]; }).sort(function (a, b) {
            return b.items.length - a.items.length || a.name.localeCompare(b.name);
        });
        if (!groups.length) return '<p class="small muted">ক্যাটালগের সাথে মেলে এমন কোনো ভার্সন নেই।</p>';
        const single = groups.filter(function (g) { return g.items.length === 1; });
        const multi = groups.filter(function (g) { return g.items.length > 1; });
        const singleHtml = single.length
            ? '<p class="small" style="margin-top: 0.75rem"><span class="muted">সব প্রজেক্টে একই ভার্সন: </span>' + single.map(function (g) {
                  const u = g.items[0];
                  return '<span class="dot s-' + u.status + '"></span> ' + esc(g.name + ' ' + u.version) + ' (' + P.num(u.projects.length) + 'টি)';
              }).join('<span class="muted"> · </span>') + '</p>'
            : '';
        return (multi.length ? '' : '<p class="small muted">কোনো প্রোডাক্টের একাধিক ভার্সন চলছে না।</p>') + multi.map(function (g) {
            const items = P.sortVersionsDesc(g.items, 'version');
            const total = items.reduce(function (s, u) { return s + u.projects.length; }, 0);
            const bar = items.map(function (u) {
                return '<span class="s-' + u.status + '" style="flex: ' + u.projects.length + '" title="' + esc(g.name + ' ' + u.version + ': ' + u.projects.length + 'টি প্রজেক্ট, ' + P.STATUS[u.status].label) + '"></span>';
            }).join('');
            const labels = items.map(function (u) {
                const href = P.url('/projects/?product=' + encodeURIComponent(g.kind + '|' + g.product) + '&version=' + encodeURIComponent(u.version));
                return '<a class="small" href="' + esc(href) + '" style="color: inherit; text-decoration: none"><span class="dot s-' + u.status + '"></span> ' + esc(u.version) + ' · ' + P.num(u.projects.length) + 'টি</a>';
            }).join('<span class="muted"> · </span>');
            return (
                '<div class="dist-row"><div><b>' + esc(g.name) + '</b><br><span class="small muted">' + P.KIND_LABEL[g.kind] + ' · ' + P.num(items.length) + 'টি ভার্সন</span></div>' +
                '<div><div class="dist-bar" role="img" aria-label="' + esc(g.name + ': মোট ' + total) + '">' + bar + '</div><div class="row" style="gap: 0.3rem 0.5rem">' + labels + '</div></div></div>'
            );
        }).join('') + singleHtml;
    }

    /* ---------- বাকি অংশ ---------- */

    function issuesHtml(issues) {
        if (!issues.length) return '<li class="muted">কোনো সমস্যা নেই।</li>';
        return issues.slice().sort(function (a, b) { return P.statusRank(b.severity) - P.statusRank(a.severity); }).map(function (i) {
            return '<li><div class="row">' + ui.pill(i.severity, i.type === 'requires' ? 'সামঞ্জস্য' : 'অমিল') + '<b>' + ui.projectLink(i.project) + '</b></div><span class="small">' + esc(i.text) + '</span></li>';
        }).join('');
    }

    function upcomingHtml(list) {
        if (!list.length) return '<tr><td colspan="5" class="muted">সতর্কতার সীমার মধ্যে কোনো ভার্সনের সাপোর্ট শেষ হচ্ছে না।</td></tr>';
        return list.map(function (u) {
            const s = P.cycleStatus(u.cycle, P.store.get().settings);
            return '<tr><td><b>' + esc(u.productName + ' ' + u.version) + '</b><br><span class="small muted">' + P.KIND_LABEL[u.kind] + '</span></td>' +
                '<td>' + ui.pill(u.status) + '</td>' +
                '<td class="num">' + (u.end ? P.fmtDate(u.end) + '<br><span class="small muted">' + (u.days < 0 ? P.num(-u.days) + ' দিন আগে' : P.num(u.days) + ' দিন বাকি') + '</span>' : 'সাপোর্ট শেষ') + '</td>' +
                '<td class="small">' + (s.phase ? P.PHASE[s.phase] : '') + '</td>' +
                '<td class="small">' + ui.projectNames(u.projects, 6) + '</td></tr>';
        }).join('');
    }

    function gapAction(g) {
        const page = g.kind === 'tech' ? '/tech/' : '/environments/';
        if (g.reason === 'no-product') return '<a class="btn btn-small" href="' + esc(P.url(page + '?new=1&name=' + encodeURIComponent(g.product))) + '">ক্যাটালগে যোগ করুন</a>';
        if (g.reason === 'no-version') return '';
        return '<a class="btn btn-small" href="' + esc(P.url(page + '?edit=' + encodeURIComponent(g.product))) + '">ক্যাটালগ এডিট করুন</a>';
    }

    function gapsHtml(gaps) {
        if (!gaps.length) return '<li class="muted">সব অংশের তথ্য আছে।</li>';
        return gaps.map(function (g) {
            const label = g.productName + (g.version ? ' ' + g.version : '');
            return '<li><div class="spread"><span><b>' + esc(label) + '</b> <span class="small muted">' + P.KIND_LABEL[g.kind] + ' · ' + esc(g.text) + '</span></span>' + gapAction(g) + '</div><span class="small muted">' + P.num(g.projects.length) + 'টি প্রজেক্ট: ' + ui.projectNames(g.projects, 6) + '</span></li>';
        }).join('');
    }

    let lastUsage = null;

    function render() {
        const data = P.store.get();
        renderFilters(data);
        const s = scoped(data);
        const has = s.rows.length > 0;
        ui.$('#empty').hidden = has;
        ui.$('#content').hidden = !has;
        ui.$('#scope').textContent = P.num(s.rows.length) + 'টি প্রজেক্ট ধরা হয়েছে' + (f.dep ? ', শুধু ' + f.dep + '-এর সার্ভার' : '') + (f.kind ? ', শুধু ' + P.KIND_LABEL[f.kind] : '') + '।';
        ui.setQuery({ dep: f.dep, kind: f.kind, archived: f.archived ? '1' : '' });
        if (!has) return;
        lastUsage = P.usage(s.rows);
        ui.$('#legend').innerHTML = ['eol', 'critical', 'warning', 'ok'].map(function (st) {
            return '<li><span class="swatch" style="background: var(--' + st + ')"></span>' + P.STATUS[st].label + '</li>';
        }).join('') + '<li><span class="swatch" style="background: var(--muted); opacity: 0.32"></span>হালকা অংশ: শুধু সিকিউরিটি ফিক্স</li>';
        timeline(lastUsage);
        ui.$('#dist').innerHTML = distribution(lastUsage);
        ui.$('#issue-list').innerHTML = issuesHtml(f.kind === 'tech' ? [] : s.issues);
        ui.$('#upcoming').innerHTML = upcomingHtml(P.upcoming(s.rows, data.settings.yellowDays));
        ui.$('#gaps').innerHTML = gapsHtml(P.gaps(s.rows));
    }

    ui.$('#f-dep').addEventListener('change', function (e) { f.dep = e.target.value; render(); });
    ui.$('#f-kind').addEventListener('change', function (e) { f.kind = e.target.value; render(); });
    ui.$('#f-archived').addEventListener('change', function (e) { f.archived = e.target.checked; render(); });

    let resizing;
    window.addEventListener('resize', function () {
        clearTimeout(resizing);
        resizing = setTimeout(function () { if (lastUsage) timeline(lastUsage); }, 150);
    });

    P.store.ready().then(render);
    ui.onChange(render);
</script>
