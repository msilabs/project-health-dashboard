<head>
    <title>{{ data.site.name }}</title>
</head>

<template>
    <div class="page-head">
        <div>
            <span class="eyebrow" id="today"></span>
            <h1>পোর্টফোলিওর স্বাস্থ্য</h1>
            <p id="lede">&nbsp;</p>
        </div>
    </div>

    <div class="stack stack-lg" id="skeleton" aria-hidden="true">
        <div class="card skeleton"><span></span><span></span><span></span></div>
        <div class="card skeleton"><span></span><span></span><span></span><span></span></div>
    </div>

    <section class="card" id="empty" hidden>
        <div class="empty">
            <span class="chip-icon"><Icon name="folder" /></span>
            <h2>এখনো কোনো প্রজেক্ট নেই</h2>
            <p>প্রজেক্ট যোগ করুন, আগের ব্যাকআপ import করুন, অথবা আপনার লেখা তথ্য থেকে AI দিয়ে বানিয়ে নিন।</p>
            <div class="row">
                <button class="btn btn-primary" type="button" data-action="new-project"><Icon name="plus" />প্রজেক্ট যোগ করুন</button>
                <button class="btn" type="button" data-action="ai"><Icon name="sparkles" />AI দিয়ে বানান</button>
                <button class="btn" type="button" data-action="import"><Icon name="upload" />Import</button>
            </div>
        </div>
    </section>

    <div class="stack stack-lg" id="content" hidden>
        <div class="overview">
            <section class="card hero" aria-label="অবস্থা অনুযায়ী প্রজেক্ট">
                <div class="hero-top">
                    <div>
                        <div class="hero-label">ঝুঁকিমুক্ত প্রজেক্ট</div>
                        <div class="hero-num" id="hero-num"></div>
                    </div>
                    <span id="hero-badge"></span>
                </div>
                <div class="segbar" id="segbar" role="img"></div>
                <div class="seg-legend" id="seg-legend"></div>
            </section>
            <div class="stats" id="stats"></div>
        </div>

        <section class="card">
            <div class="card-head">
                <div>
                    <h2>করণীয়</h2>
                    <p>সাপোর্ট শেষ বা শিগগির শেষ হওয়া ভার্সন, আর যেখানে সার্ভারের সাথে টেকের মিল নেই</p>
                </div>
                <button class="btn btn-ghost btn-sm" type="button" id="report"><Icon name="report" />AI রিপোর্ট</button>
            </div>
            <div id="todo"></div>
            <div class="card-foot" id="todo-foot" hidden><button class="link-btn" type="button" id="todo-more"></button></div>
        </section>

        <section class="card">
            <div class="card-head">
                <div>
                    <h2>সাপোর্ট টাইমলাইন</h2>
                    <p>প্রজেক্টে চলা প্রতিটা ভার্সনের রিলিজ থেকে সাপোর্ট শেষ পর্যন্ত। গাঢ় অংশ সক্রিয় সাপোর্ট, হালকা অংশ শুধু সিকিউরিটি ফিক্স।</p>
                </div>
                <div class="segmented" id="tl-kind" role="group" aria-label="ধরন"></div>
            </div>
            <div class="card-body stack">
                <ul class="legend" id="legend"></ul>
                <div class="chart" id="timeline"></div>
            </div>
        </section>
    </div>
</template>

<script>
    const P = PHD;
    const ui = P.ui;
    const esc = P.esc;
    let showAll = false;
    let tlKind = 'all';
    let lastRows = [];

    function overview(a, data) {
        const safe = a.counts.ok;
        const pct = a.total ? Math.round((safe / a.total) * 100) : 0;
        ui.$('#hero-num').innerHTML = P.num(pct) + '%<small>' + P.num(safe) + '/' + P.num(a.total) + 'টি প্রজেক্ট</small>';
        const risky = a.counts.eol + a.counts.critical;
        ui.$('#hero-badge').innerHTML = risky ? ui.badge('eol', P.num(risky) + 'টিতে এখনই কাজ দরকার') : ui.badge('ok', 'জরুরি কিছু নেই');
        ui.$('#segbar').setAttribute('aria-label', P.STATUS_ORDER.map(function (s) { return P.STATUS[s].label + ' ' + a.counts[s]; }).join(', '));
        ui.$('#segbar').innerHTML = P.STATUS_ORDER.filter(function (s) { return a.counts[s]; }).map(function (s) {
            return '<span class="s-' + s + '" style="flex: ' + a.counts[s] + '" data-tip="' + esc(P.STATUS[s].label + ': ' + P.num(a.counts[s]) + 'টি প্রজেক্ট') + '"></span>';
        }).join('');
        ui.$('#seg-legend').innerHTML = P.STATUS_ORDER.map(function (s) {
            return '<a href="' + esc(P.url('/projects/?status=' + s)) + '"><span class="lbl"><span class="dot s-' + s + '"></span>' + P.STATUS[s].label + '</span><span class="val">' + P.num(a.counts[s]) + '</span></a>';
        }).join('');

        const up = P.upcoming(a.rows, 36500);
        const next = up.filter(function (u) { return u.days !== null && u.days >= 0; })[0];
        const ended = up.filter(function (u) { return u.days === null || u.days < 0; });
        const soon = up.filter(function (u) { return u.days !== null && u.days >= 0 && u.days <= data.settings.redDays; });
        const stats = [
            { icon: 'alert', s: 'eol', label: 'সাপোর্ট শেষ হয়েও চলছে', num: P.num(ended.length), sub: ended.length ? ended.slice(0, 2).map(function (u) { return u.productName + ' ' + u.version; }).join(', ') + (ended.length > 2 ? ' …' : '') : 'কোনো ভার্সন নেই' },
            { icon: 'clock', s: 'critical', label: P.num(data.settings.redDays) + ' দিনের মধ্যে শেষ', num: P.num(soon.length), sub: soon.length ? soon.map(function (u) { return u.productName + ' ' + u.version; }).slice(0, 2).join(', ') : 'কোনো ভার্সন নেই' },
            { icon: 'compare', s: 'warning', label: 'সামঞ্জস্য আর অমিল', num: P.num(a.issues.length), sub: a.issues.length ? P.num(a.issues.filter(function (i) { return i.type === 'requires'; }).length) + 'টি রানটাইম, ' + P.num(a.issues.filter(function (i) { return i.type === 'drift'; }).length) + 'টি এনভায়রনমেন্টে অমিল' : 'সব মিলছে' },
            { icon: 'calendar', s: 'unknown', label: 'পরের শেষ তারিখ', num: next ? P.num(next.days) + ' দিন' : '—', sub: next ? next.productName + ' ' + next.version + ' · ' + P.fmtDate(next.end) : 'সামনে কোনো তারিখ নেই' }
        ];
        ui.$('#stats').innerHTML = stats.map(function (x) {
            return '<div class="card stat"><div class="stat-top"><span>' + esc(x.label) + '</span><span class="chip-icon s-' + x.s + '">' + ui.icon(x.icon) + '</span></div><div><div class="stat-num">' + esc(x.num) + '</div><div class="stat-sub">' + esc(x.sub) + '</div></div></div>';
        }).join('');
    }

    const TYPE_ICON = { version: 'clock', requires: 'unlink', drift: 'compare' };

    function todoItem(t) {
        const icon = t.type === 'version' && t.status === 'eol' ? 'alert' : TYPE_ICON[t.type];
        const pill = t.type === 'version' ? ui.badge(t.status, t.days < 0 || t.days === -1e9 ? 'শেষ' : P.num(t.days) + ' দিন') : ui.badge(t.status, t.type === 'requires' ? 'অসামঞ্জস্য' : 'অমিল');
        return (
            '<li><span class="chip-icon s-' + t.status + '">' + ui.icon(icon) + '</span>' +
            '<div class="item-main"><div class="item-title">' + esc(t.title) + '</div>' +
            '<div class="item-sub">' + (t.text ? esc(t.text) + ' · ' : '') + ui.projectNames(t.projects) + '</div></div>' +
            '<div class="item-meta">' + pill + (t.meta ? '<span>' + esc(t.meta.replace(/^.*· /, '')) + '</span>' : '') + '</div></li>'
        );
    }

    function todo(rows, settings) {
        const all = P.todo(rows, settings);
        const list = showAll ? all : all.slice(0, 6);
        const groups = { now: 'এখনই', soon: 'শিগগির' };
        let html = '';
        Object.keys(groups).forEach(function (level) {
            const items = list.filter(function (t) { return t.level === level; });
            if (!items.length) return;
            const total = all.filter(function (t) { return t.level === level; }).length;
            html += '<div class="group-label">' + groups[level] + ' <span class="badge neutral">' + P.num(total) + '</span></div><ul class="items">' + items.map(todoItem).join('') + '</ul>';
        });
        ui.$('#todo').innerHTML = html || '<div class="empty"><span class="chip-icon s-ok">' + ui.icon('shield') + '</span><p>কিছু করার নেই। সব জানা অংশে সাপোর্ট আছে।</p></div>';
        ui.$('#todo-foot').hidden = all.length <= 6;
        ui.$('#todo-more').textContent = showAll ? 'কম দেখান' : 'সব ' + P.num(all.length) + 'টি দেখুন';
    }

    /* ---------- টাইমলাইন ---------- */

    function timeline(rows) {
        const el = ui.$('#timeline');
        const usage = P.usage(rows);
        const list = Object.keys(usage).map(function (k) { return usage[k]; }).filter(function (u) {
            return (tlKind === 'all' || u.kind === tlKind) && (u.cycle.released || u.end);
        });
        ui.$('#tl-kind').innerHTML = [['all', 'সব'], ['tech', P.KIND_LABEL.tech], ['env', P.KIND_LABEL.env]].map(function (k) {
            return '<button type="button" data-kind="' + k[0] + '" aria-pressed="' + (tlKind === k[0]) + '">' + k[1] + '</button>';
        }).join('');
        if (!list.length) {
            el.innerHTML = '<p class="small muted">তারিখসহ কোনো ভার্সন নেই।</p>';
            return;
        }
        list.sort(function (a, b) {
            return P.KINDS.indexOf(a.kind) - P.KINDS.indexOf(b.kind) || a.productName.localeCompare(b.productName) || P.compareVersions(b.version, a.version);
        });
        const today = P.today();
        const year = function (t) { return new Date(t).getUTCFullYear(); };
        let minT = today;
        let maxT = today;
        list.forEach(function (u) {
            const r = P.parseDate(u.cycle.released);
            const e = P.parseDate(u.end);
            if (r !== null) minT = Math.min(minT, r);
            if (e !== null) maxT = Math.max(maxT, e);
        });
        const y0 = Math.max(year(minT), year(today) - 5);
        const y1 = Math.min(year(maxT) + 1, year(today) + 6);
        const d0 = Date.UTC(y0, 0, 1);
        const d1 = Date.UTC(y1, 0, 1);
        const W = Math.max(620, el.clientWidth || 900);
        const L = 150;
        const R = 56;
        const rowH = 24;
        const top = 34;
        const x = function (t) { return L + ((Math.min(Math.max(t, d0), d1) - d0) / (d1 - d0)) * (W - L - R); };
        const groups = [];
        let y = top;
        list.forEach(function (u) {
            const g = u.kind + u.product;
            if (!groups.length || groups[groups.length - 1].key !== g) groups.push({ key: g, y: y, rows: 0 });
            groups[groups.length - 1].rows++;
            u._y = y;
            y += rowH;
        });
        const H = y + 6;
        const out = ['<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="ভার্সনের সাপোর্ট টাইমলাইন">'];
        groups.forEach(function (g, i) {
            if (i % 2 === 0) out.push('<rect class="band" x="0" y="' + g.y + '" width="' + W + '" height="' + g.rows * rowH + '" rx="6"></rect>');
        });
        for (let yr = y0; yr <= y1; yr++) {
            const gx = x(Date.UTC(yr, 0, 1));
            out.push('<line class="grid" x1="' + gx + '" x2="' + gx + '" y1="' + (top - 4) + '" y2="' + H + '"></line>');
            if ((yr - y0) % (y1 - y0 > 9 ? 2 : 1) === 0 && Math.abs(gx - x(today)) > 28) out.push('<text class="tick" x="' + gx + '" y="' + (top - 10) + '" text-anchor="middle">' + yr + '</text>');
        }
        list.forEach(function (u) {
            const yy = u._y;
            const by = yy + (rowH - 8) / 2;
            const rel = P.parseDate(u.cycle.released);
            const end = P.parseDate(u.end);
            const sup = P.parseDate(u.cycle.supportUntil);
            const x0 = x(rel !== null ? rel : d0);
            const xe = end !== null ? x(end) : x(d1);
            const xa = sup !== null ? x(sup) : xe;
            const color = 'var(--' + u.status + ')';
            const tip = u.productName + ' ' + u.version + '\n' +
                (u.cycle.released ? 'রিলিজ: ' + P.fmtDate(u.cycle.released) + '\n' : '') +
                (u.cycle.supportUntil ? 'সক্রিয় সাপোর্ট: ' + P.fmtDate(u.cycle.supportUntil) + ' পর্যন্ত\n' : '') +
                (u.end ? 'সাপোর্ট শেষ: ' + P.fmtDate(u.end) : 'শেষের তারিখ ঘোষিত নয়') + '\n' +
                P.STATUS[u.status].label + ' · ' + P.num(u.projects.length) + 'টি প্রজেক্ট';
            out.push('<g data-tip="' + esc(tip) + '">');
            out.push('<rect x="0" y="' + yy + '" width="' + W + '" height="' + rowH + '" fill="transparent"></rect>');
            out.push('<text x="' + (L - 12) + '" y="' + (yy + rowH / 2 + 4) + '" text-anchor="end">' + esc(u.productName + ' ' + u.version) + '</text>');
            out.push('<rect x="' + x0 + '" y="' + by + '" width="' + Math.max(4, xe - x0) + '" height="8" rx="4" fill="' + color + '" opacity="0.25"></rect>');
            if (xa > x0) out.push('<rect x="' + x0 + '" y="' + by + '" width="' + Math.max(4, xa - x0) + '" height="8" rx="4" fill="' + color + '"></rect>');
            out.push('<text class="tick" x="' + (W - R + 12) + '" y="' + (yy + rowH / 2 + 4) + '">' + P.num(u.projects.length) + 'টি</text>');
            out.push('</g>');
        });
        const tx = x(today);
        out.push('<line class="today" x1="' + tx + '" x2="' + tx + '" y1="' + (top - 2) + '" y2="' + H + '"></line>');
        out.push('<rect class="today-pill" x="' + (tx - 16) + '" y="' + (top - 22) + '" width="32" height="16" rx="8"></rect>');
        out.push('<text class="today-text" x="' + tx + '" y="' + (top - 10.5) + '" text-anchor="middle">আজ</text>');
        out.push('</svg>');
        el.innerHTML = out.join('');
    }

    function render() {
        const data = P.store.get();
        const a = P.analyze(data);
        lastRows = a.rows;
        ui.$('#today').textContent = 'আজ, ' + new Intl.DateTimeFormat('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' }).format(P.now());
        ui.$('#skeleton').hidden = true;
        ui.$('#empty').hidden = a.total > 0;
        ui.$('#content').hidden = a.total === 0;
        ui.$('#lede').textContent = a.total ? P.summaryText(a, data.settings) : 'প্রজেক্টের টেক আর সার্ভারের ভার্সন যোগ করলে এখানে দেখাবে কোনটার সাপোর্ট কবে শেষ হচ্ছে।';
        if (!a.total) return;
        overview(a, data);
        todo(a.rows, data.settings);
        ui.$('#legend').innerHTML = ['eol', 'critical', 'warning', 'ok'].map(function (st) {
            return '<li class="s-' + st + '"><span class="swatch"></span>' + P.STATUS[st].label + '</li>';
        }).join('');
        timeline(a.rows);
    }

    ui.$('#report').addEventListener('click', function () {
        ui.showPrompt('ম্যানেজমেন্ট রিপোর্ট', P.aiPrompts.report(P.store.get(), ''), 'সব প্রজেক্টের অবস্থা থেকে ম্যানেজারদের জন্য সহজ ভাষায় ছোট রিপোর্ট।');
    });
    ui.$('#todo-more').addEventListener('click', function () {
        showAll = !showAll;
        todo(lastRows, P.store.get().settings);
    });
    ui.$('#tl-kind').addEventListener('click', function (e) {
        const b = e.target.closest('[data-kind]');
        if (!b) return;
        tlKind = b.dataset.kind;
        timeline(lastRows);
    });
    let resizing;
    window.addEventListener('resize', function () {
        clearTimeout(resizing);
        resizing = setTimeout(function () { if (lastRows.length) timeline(lastRows); }, 150);
    });

    P.store.ready().then(render);
    ui.onChange(render);
</script>
